@page "/dice-test"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using MudBlazor
@using Microsoft.AspNetCore.SignalR.Client
@using NightCityVTT.Shared.Services
@using NightCityVTT.Shared.Models
@inject DiceEngine Dice
@inject NavigationManager Nav
@implements IAsyncDisposable

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />

<PageTitle>Dice Terminal — Night City VTT</PageTitle>

<div class="dt-page">

    <!-- HEADER BAR -->
    <div class="dt-page-header">
        <div class="dt-page-header-left">
            <a href="/" class="dt-back-link">← BACK</a>
            <span class="dt-page-title">// DICE ENGINE — FULL TERMINAL //</span>
        </div>
        <div class="dt-page-header-right">
            <span class="dt-hub-badge @(_hubConnected ? "hub-live" : "hub-off")">
                @(_hubConnected ? "◉ LIVE" : "◌ OFFLINE")
            </span>
            <span class="dt-clock-badge">@_clock</span>
            <span class="dt-rolls-badge">ROLLS: @_rollCount</span>
        </div>
    </div>

    <div class="dt-page-body">

        <!-- LEFT: Die + Controls -->
        <div class="dt-controls-panel">

            <!-- ANIMATED DIE -->
            <div class="die-area">
                <div class="die-shadow-wrap @_dieState">
                    <div class="die-face">
                        <span class="die-type">@_dieTypeLabel</span>
                        <span class="die-val">@_dieDisplay</span>
                    </div>
                </div>

                <div class="die-result-block">
                    @if (_isRolling)
                    {
                        <span class="die-status-rolling">ROLLING...</span>
                    }
                    else if (_lastResult != null)
                    {
                        <span class="die-result-label">@_lastResult.Label</span>
                        @if (_lastResult.IsCriticalSuccess)
                        {
                            <span class="die-badge die-badge-crit">★ CRITICAL</span>
                        }
                        else if (_lastResult.IsFumble)
                        {
                            <span class="die-badge die-badge-fumble">✕ FUMBLE</span>
                        }
                        @if (_lastResult.Dice.Count > 1 || _lastResult.Total != _lastResult.Dice.FirstOrDefault())
                        {
                            <span class="die-total-line">TOTAL &nbsp;<strong>@_lastResult.Total</strong></span>
                        }
                        <span class="die-dice-line">[ @string.Join("  ", _lastResult.Dice) ]</span>
                    }
                    else
                    {
                        <span class="die-status-idle">— AWAITING ROLL —</span>
                    }
                </div>
            </div>

            <!-- ATTRIBUTES -->
            <div class="dt-section">
                <div class="dt-section-title">// ATTRIBUTES //</div>
                <div class="dt-input-grid4">
                    <MudNumericField T="int" @bind-Value="_stat"  Label="STAT"         Variant="Variant.Outlined" Min="1" Max="10" HideSpinButtons="true" />
                    <MudNumericField T="int" @bind-Value="_skill" Label="SKILL"        Variant="Variant.Outlined" Min="0" Max="10" HideSpinButtons="true" />
                    <MudNumericField T="int" @bind-Value="_luck"  Label="LUCK"         Variant="Variant.Outlined" Min="0" Max="10" HideSpinButtons="true" />
                    <MudNumericField T="int" @bind-Value="_body"  Label="BODY"         Variant="Variant.Outlined" Min="1" Max="10" HideSpinButtons="true" />
                    <MudNumericField T="int" @bind-Value="_ref"   Label="REF"          Variant="Variant.Outlined" Min="1" Max="10" HideSpinButtons="true" />
                    <MudNumericField T="int" @bind-Value="_cs"    Label="COMBAT SENSE" Variant="Variant.Outlined" Min="0" Max="10" HideSpinButtons="true" />
                </div>
            </div>

            <!-- DAMAGE FORMULA -->
            <div class="dt-section">
                <div class="dt-section-title">// DAMAGE FORMULA //</div>
                <MudTextField @bind-Value="_damageFormula" Label="e.g. 3D6+1 / 2D6 / 1D10" Variant="Variant.Outlined" FullWidth="true" />
            </div>

            <!-- ACTIONS -->
            <div class="dt-section">
                <div class="dt-section-title">// QUICK ACTIONS //</div>
                <div class="dt-btn-grid">
                    <MudButton Variant="Variant.Filled" Color="Color.Error"     FullWidth="true" Size="Size.Large"
                               OnClick="@(() => _ = AnimatedRoll(() => Dice.RollSkillCheck(_stat, _skill, _luck), "D10"))" Disabled="_isRolling">
                        SKILL CHECK
                        <br/><span class="btn-sub">1D10 + STAT + SKILL + LUCK</span>
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning"   FullWidth="true" Size="Size.Large"
                               OnClick="@(() => _ = AnimatedRoll(() => Dice.RollDamage(_damageFormula), _damageFormula))" Disabled="_isRolling">
                        ATTACK
                        <br/><span class="btn-sub">PARSE DAMAGE FORMULA</span>
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Info"      FullWidth="true" Size="Size.Large"
                               OnClick="@(() => _ = AnimatedRoll(() => Dice.RollInitiative(_ref, _cs), "D10"))" Disabled="_isRolling">
                        INITIATIVE
                        <br/><span class="btn-sub">1D10 + REF + COMBAT SENSE</span>
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" Size="Size.Large"
                               OnClick="@(() => _ = AnimatedRoll(() => Dice.PerformSave(_body), "D10"))" Disabled="_isRolling">
                        SAVE
                        <br/><span class="btn-sub">1D10 vs BODY TYPE</span>
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" FullWidth="true"
                               OnClick="@(() => _ = AnimatedRoll(() => Dice.RollManual(10), "D10"))" Disabled="_isRolling">
                        MANUAL D10
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" FullWidth="true"
                               OnClick="@(() => _ = AnimatedRoll(() => Dice.RollManual(6), "D6"))" Disabled="_isRolling">
                        MANUAL D6
                    </MudButton>
                </div>
            </div>

        </div>

        <!-- RIGHT: CRT Log -->
        <div class="dt-log-panel">
            <div class="dt-log-header">
                <span>// ROLL LOG //</span>
                <button class="dt-clear-btn" @onclick="ClearLog">CLEAR</button>
            </div>
            <div class="dt-full-log">
                @if (_log.Count == 0)
                {
                    <div class="log-line log-dim">_ SYSTEM READY — AWAITING INPUT _</div>
                }
                @foreach (var entry in _log)
                {
                    <div class="log-line @entry.Css">@entry.Text</div>
                }
            </div>
        </div>

    </div>
</div>

<style>
    /* ── PAGE SHELL ──────────────────────────────────────────── */
    .dt-page { display: flex; flex-direction: column; min-height: calc(100vh - 49px); background: var(--nc-dark); }

    .dt-page-header { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 2rem; border-bottom: 1px solid var(--nc-border); background: var(--nc-panel); }
    .dt-page-header-left { display: flex; align-items: center; gap: 1.5rem; }
    .dt-back-link { font-family: var(--font-mono); font-size: 0.72rem; color: var(--nc-dim); text-decoration: none; letter-spacing: 0.1em; transition: color 0.15s; }
    .dt-back-link:hover { color: var(--nc-cyan); }
    .dt-page-title { font-family: var(--font-display); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.15em; color: var(--nc-red); }
    .dt-page-header-right { display: flex; gap: 1.2rem; align-items: center; }
    .dt-clock-badge, .dt-rolls-badge { font-family: var(--font-mono); font-size: 0.68rem; color: var(--nc-dim); letter-spacing: 0.1em; }

    .dt-hub-badge { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.12em; }
    .dt-hub-badge.hub-live { color: var(--nc-green); }
    .dt-hub-badge.hub-off  { color: var(--nc-dim); }

    .dt-page-body { display: grid; grid-template-columns: 460px 1fr; flex: 1; min-height: 0; }

    /* ── LEFT CONTROLS ───────────────────────────────────────── */
    .dt-controls-panel { border-right: 1px solid var(--nc-border); padding: 1.2rem; display: flex; flex-direction: column; gap: 1rem; overflow-y: auto; }
    .dt-section-title { font-size: 0.58rem; letter-spacing: 0.2em; color: var(--nc-dim); border-bottom: 1px solid var(--nc-border); padding-bottom: 0.25rem; margin-bottom: 0.55rem; }
    .dt-input-grid4 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.45rem; }
    .dt-btn-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.45rem; }
    .btn-sub { font-size: 0.52rem; opacity: 0.65; letter-spacing: 0.04em; display: block; margin-top: 2px; }

    /* ── ANIMATED DIE ────────────────────────────────────────── */
    .die-area {
        display: flex;
        gap: 1.5rem;
        align-items: center;
        padding: 1.4rem 1rem;
        background: #06080b;
        border: 1px solid var(--nc-border);
    }

    .die-shadow-wrap {
        flex-shrink: 0;
        filter: drop-shadow(0 0 0px transparent);
        transition: filter 0.35s ease;
    }
    .die-shadow-wrap.settled { filter: drop-shadow(0 0 16px rgba(0,229,255,0.55)); }
    .die-shadow-wrap.crit    { filter: drop-shadow(0 0 24px rgba(245,197,24,0.75)); }
    .die-shadow-wrap.fumble  { filter: drop-shadow(0 0 20px rgba(255,0,60,0.65)); }
    .die-shadow-wrap.rolling { filter: drop-shadow(0 0 10px rgba(245,197,24,0.35)); }

    .die-face {
        width: 140px;
        height: 140px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.1rem;
        background: linear-gradient(145deg, #0d0f14, #070a0d);
        border: 3px solid var(--nc-border);
        clip-path: polygon(29% 0%, 71% 0%, 100% 29%, 100% 71%, 71% 100%, 29% 100%, 0% 71%, 0% 29%);
        transition: border-color 0.25s;
        position: relative;
    }

    .die-type {
        font-family: var(--font-mono);
        font-size: 0.58rem;
        letter-spacing: 0.18em;
        color: var(--nc-dim);
        line-height: 1;
    }

    .die-val {
        font-family: var(--font-display);
        font-size: 3.2rem;
        font-weight: 900;
        line-height: 1;
        color: var(--nc-cyan);
        transition: color 0.2s;
    }

    .die-shadow-wrap.idle    .die-face { border-color: var(--nc-border); }
    .die-shadow-wrap.rolling .die-face { border-color: var(--nc-gold); animation: die-shake 0.09s linear infinite; }
    .die-shadow-wrap.settled .die-face { border-color: var(--nc-cyan); animation: die-land 0.45s cubic-bezier(.36,.07,.19,.97) forwards; }
    .die-shadow-wrap.crit    .die-face { border-color: var(--nc-gold); animation: die-land 0.45s cubic-bezier(.36,.07,.19,.97) forwards; }
    .die-shadow-wrap.fumble  .die-face { border-color: var(--nc-red);  animation: die-land 0.45s cubic-bezier(.36,.07,.19,.97) forwards; }

    .die-shadow-wrap.rolling .die-val { color: var(--nc-gold); }
    .die-shadow-wrap.settled .die-val { color: var(--nc-cyan); }
    .die-shadow-wrap.crit    .die-val { color: var(--nc-gold); }
    .die-shadow-wrap.fumble  .die-val { color: var(--nc-red); }

    @@keyframes die-shake {
        0%   { transform: translate(-3px,-2px) rotate(-3deg) scale(1.03); }
        25%  { transform: translate( 3px, 2px) rotate( 3deg) scale(0.97); }
        50%  { transform: translate(-2px, 3px) rotate(-1deg) scale(1.02); }
        75%  { transform: translate( 2px,-3px) rotate( 2deg) scale(0.98); }
        100% { transform: translate(-3px,-2px) rotate(-3deg) scale(1.03); }
    }

    @@keyframes die-land {
        0%   { transform: scale(1.3)  rotate( 7deg); }
        30%  { transform: scale(0.88) rotate(-3deg); }
        58%  { transform: scale(1.07) rotate( 1deg); }
        78%  { transform: scale(0.97) rotate( 0deg); }
        100% { transform: scale(1)    rotate( 0deg); }
    }

    .die-result-block { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
    .die-status-idle    { font-family: var(--font-mono); font-size: 0.7rem; color: var(--nc-dim); letter-spacing: 0.1em; font-style: italic; }
    .die-status-rolling { font-family: var(--font-display); font-size: 0.8rem; color: var(--nc-gold); letter-spacing: 0.15em; animation: pulse-text 0.5s ease-in-out infinite alternate; }
    .die-result-label   { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.18em; color: var(--nc-dim); text-transform: uppercase; }
    .die-badge {
        display: inline-block;
        padding: 0.15rem 0.55rem;
        font-family: var(--font-mono);
        font-size: 0.62rem;
        letter-spacing: 0.15em;
        font-weight: bold;
        align-self: flex-start;
    }
    .die-badge-crit   { background: var(--nc-gold); color: #000; }
    .die-badge-fumble { background: var(--nc-red);  color: #000; }
    .die-total-line { font-family: var(--font-display); font-size: 1.5rem; color: var(--nc-cream); }
    .die-total-line strong { color: var(--nc-cyan); }
    .die-dice-line { font-family: var(--font-mono); font-size: 0.7rem; color: var(--nc-dim); letter-spacing: 0.08em; }

    @@keyframes pulse-text { from { opacity: 0.5; } to { opacity: 1; } }

    /* ── LOG PANEL ───────────────────────────────────────────── */
    .dt-log-panel { display: flex; flex-direction: column; min-height: 0; }
    .dt-log-header { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 1.2rem; border-bottom: 1px solid var(--nc-border); font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.15em; color: var(--nc-dim); flex-shrink: 0; }
    .dt-clear-btn { background: transparent; border: 1px solid var(--nc-border); color: var(--nc-dim); font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.1em; padding: 0.18rem 0.55rem; cursor: pointer; transition: all 0.15s; }
    .dt-clear-btn:hover { border-color: var(--nc-red); color: var(--nc-red); }

    .dt-full-log {
        flex: 1;
        padding: 1rem 1.5rem;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        overflow-y: auto;
        background: #060809;
        position: relative;
    }
    .dt-full-log::after {
        content: '';
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.05) 3px, rgba(0,0,0,0.05) 4px);
        pointer-events: none;
    }

    .log-line              { padding: 0.12rem 0; line-height: 1.6; color: var(--nc-cyan); }
    .log-line.log-crit     { color: var(--nc-gold);  font-weight: bold; }
    .log-line.log-fumble   { color: var(--nc-red);   font-weight: bold; }
    .log-line.log-result   { color: var(--nc-green); }
    .log-line.log-dim      { color: var(--nc-dim);   font-style: italic; }
    .log-line.log-remote        { color: var(--nc-green); font-style: italic; }
    .log-line.log-remote-crit   { color: var(--nc-gold);  font-style: italic; font-weight: bold; }
    .log-line.log-remote-fumble { color: var(--nc-red);   font-style: italic; font-weight: bold; }
    .log-line.log-sep      { color: var(--nc-border); letter-spacing: 0.05em; }
</style>

@code {
    private int _stat = 5, _skill = 3, _luck = 0, _body = 5, _ref = 6, _cs = 2;
    private string _damageFormula = "3D6";
    private string _clock = string.Empty;
    private int _rollCount = 0;

    private bool _isRolling = false;
    private string _dieDisplay = "—";
    private string _dieTypeLabel = string.Empty;
    private string _dieState = "idle";
    private RollResult? _lastResult;

    private readonly List<(string Text, string Css)> _log = new();
    private System.Timers.Timer? _clockTimer;

    private HubConnection? _hub;
    private bool _hubConnected = false;

    private static readonly int[] RollDelays = [50, 50, 55, 60, 65, 75, 90, 110, 135, 160, 200, 245, 280];

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary       = "#ff003c",
            Secondary     = "#00e5ff",
            Background    = "#111214",
            Surface       = "#16181c",
            TextPrimary   = "#e8e0cc",
            TextSecondary = "#4a4f5a",
        }
    };

    protected override void OnInitialized()
    {
        _clock = DateTime.Now.ToString("HH:mm:ss");
        _clockTimer = new System.Timers.Timer(1000);
        _clockTimer.Elapsed += (_, _) =>
        {
            _clock = DateTime.Now.ToString("HH:mm:ss");
            InvokeAsync(StateHasChanged);
        };
        _clockTimer.Start();
    }

    protected override async Task OnInitializedAsync()
    {
        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/game"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<RollResult, string>("ReceiveRoll", (result, player) =>
        {
            AppendRemoteRoll(result, player);
            InvokeAsync(StateHasChanged);
        });

        _hub.Reconnected  += _ => { _hubConnected = true;  return InvokeAsync(StateHasChanged); };
        _hub.Reconnecting += _ => { _hubConnected = false; return InvokeAsync(StateHasChanged); };
        _hub.Closed       += _ => { _hubConnected = false; return InvokeAsync(StateHasChanged); };

        try
        {
            await _hub.StartAsync();
            _hubConnected = true;
        }
        catch { /* hub unavailable — app still works offline */ }
    }

    private async Task AnimatedRoll(Func<RollResult> rollFn, string dieType)
    {
        if (_isRolling) return;

        _isRolling    = true;
        _dieState     = "rolling";
        _dieDisplay   = "?";
        _dieTypeLabel = dieType;
        _lastResult   = null;
        StateHasChanged();

        var rng   = new Random();
        int sides = dieType == "D6" ? 6 : 10;

        foreach (var delay in RollDelays)
        {
            _dieDisplay = rng.Next(1, sides + 1).ToString();
            StateHasChanged();
            await Task.Delay(delay);
        }

        var result  = rollFn();
        _lastResult = result;
        _rollCount++;

        _dieDisplay = result.Dice.Count == 1
            ? result.Dice[0].ToString()
            : result.Total.ToString();

        _dieState  = result.IsCriticalSuccess ? "crit"
                   : result.IsFumble          ? "fumble"
                   : "settled";
        _isRolling = false;

        AppendToLog(result);

        if (_hub?.State == HubConnectionState.Connected)
        {
            try { await _hub.SendAsync("BroadcastRoll", result, "GM"); }
            catch { /* fire and forget */ }
        }

        StateHasChanged();
    }

    private void AppendToLog(RollResult r)
    {
        foreach (var line in r.Log)
        {
            string css = line.Contains("[CRITICAL") ? "log-crit"
                       : line.Contains("[FUMBLE")   ? "log-fumble"
                       : line.Contains("= ")        ? "log-result"
                       : string.Empty;
            _log.Insert(0, (line, css));
        }
        if (_log.Count > 200) _log.RemoveRange(200, _log.Count - 200);
    }

    private void AppendRemoteRoll(RollResult r, string player)
    {
        _log.Insert(0, ("────────────────────────────────", "log-sep"));
        string badge = r.IsCriticalSuccess ? " ★ CRIT" : r.IsFumble ? " ✕ FUMBLE" : string.Empty;
        string css   = r.IsCriticalSuccess ? "log-remote-crit" : r.IsFumble ? "log-remote-fumble" : "log-remote";
        _log.Insert(0, ($"[{player.ToUpperInvariant()}] {r.Label} → {r.Total}{badge}", css));
        if (_log.Count > 200) _log.RemoveRange(200, _log.Count - 200);
    }

    private void ClearLog() { _log.Clear(); _lastResult = null; _dieState = "idle"; _dieDisplay = "—"; }

    public async ValueTask DisposeAsync()
    {
        _clockTimer?.Dispose();
        if (_hub is not null)
            await _hub.DisposeAsync();
    }
}
