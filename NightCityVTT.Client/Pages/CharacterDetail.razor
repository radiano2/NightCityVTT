@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private CharacterSheet? _character;
    private bool _loading = true;
    private string _installLog = string.Empty;
    private bool   _installSuccess;

    // ── HUMANITY COMPUTED ──
    private string HumanityStatus => _character?.Humanity switch {
        >= 71 => "NOMINAL",
        >= 41 => "STRAINED",
        >= 21 => "DISORDER",
        >= 11 => "PSYCHOSIS IMMINENT",
        >= 1  => "PRE-PSYCHOTIC",
        _     => "CYBERPSYCHO"
    };
    private string HumanityClass => _character?.Humanity switch {
        >= 71 => "hu-ok",
        >= 41 => "hu-warn",
        >= 21 => "hu-bad",
        >= 11 => "hu-danger",
        >= 1  => "hu-critical",
        _     => "hu-psycho"
    };

    private int TotalEV => GetTotalEV();

    private int GetTotalEV()
    {
        if (_character == null || _character.EquippedGearIds == null) return 0;
        int ev = 0;
        foreach (var id in _character.EquippedGearIds.Values.Distinct())
        {
            var item = _character.Inventory.FirstOrDefault(i => i.InstanceId == id);
            if (item != null && int.TryParse(item.EV, out int val))
            {
                ev += val;
            }
        }
        return ev;
    }

    private async Task DecrementLuck()
    {
        if (_character == null || _character.CurrentLuck <= 0) return;
        _character.CurrentLuck--;
        await CharApi.UpdateAsync(_character);
    }

    private async Task IncrementLuck()
    {
        if (_character == null || _character.CurrentLuck >= _character.LK) return;
        _character.CurrentLuck++;
        await CharApi.UpdateAsync(_character);
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _character = await CharApi.GetByIdAsync(Id);
        _loading = false;
        StateHasChanged();
    }

    // ── CYBERWARE INSTALL / UNINSTALL ──
    private async Task HandleCyberDrop()
    {
        if (_draggedItem == null || _character == null) return;
        if (_draggedItem.Category != "Cyberware") { _draggedItem = null; return; }
        if (_character.InstalledCyberwareIds.Contains(_draggedItem.InstanceId)) { _draggedItem = null; return; }

        _character.InstalledCyberwareIds.Add(_draggedItem.InstanceId);

        if (!string.IsNullOrEmpty(_draggedItem.HumanityCostDice)
            && !_character.HumanityPaidByInstanceId.ContainsKey(_draggedItem.InstanceId))
        {
            var roll = Dice.RollDamage(_draggedItem.HumanityCostDice);
            _character.HumanityPaidByInstanceId[_draggedItem.InstanceId] = roll.Total;
            _character.Humanity = Math.Max(0, _character.Humanity - roll.Total);
            _character.EMP = _character.Humanity / 10;
            _installLog = $"NEURAL LINK INSTALLED — {_draggedItem.Name.ToUpper()} — HUMANITY –{roll.Total} — CURRENT: {_character.Humanity}";
            _installSuccess = false;
        }
        else
        {
            _installLog = $"IMPLANT REGISTERED — {_draggedItem.Name.ToUpper()} — NO HUMANITY COST";
            _installSuccess = true;
        }

        _draggedItem = null;
        await CharApi.UpdateAsync(_character);
        StateHasChanged();
    }

    private async Task UninstallCyberware(GearItemDto item)
    {
        if (_character == null) return;
        _character.InstalledCyberwareIds.Remove(item.InstanceId);

        if (_character.HumanityPaidByInstanceId.TryGetValue(item.InstanceId, out int paid))
        {
            _character.Humanity = Math.Min(100, _character.Humanity + paid);
            _character.EMP = _character.Humanity / 10;
            _character.HumanityPaidByInstanceId.Remove(item.InstanceId);
            _installLog = $"IMPLANT EXTRACTED — {item.Name.ToUpper()} — HUMANITY +{paid} — CURRENT: {_character.Humanity}";
            _installSuccess = true;
        }
        else
        {
            _installLog = $"IMPLANT REMOVED — {item.Name.ToUpper()}";
            _installSuccess = true;
        }

        await CharApi.UpdateAsync(_character);
        StateHasChanged();
    }

    private async Task UpgradeSkill(string skillName)
    {
        if (_character == null) return;
        var skills = JsonSerializer.Deserialize<Dictionary<string, int>>(_character.SkillsJson) ?? new();
        if (skills.TryGetValue(skillName, out int level))
        {
            int cost = level == 0 ? 10 : level * 10;
            
            if (_character.IP >= cost && level < 10)
            {
                _character.IP -= cost;
                skills[skillName] = level + 1;
                _character.SkillsJson = JsonSerializer.Serialize(skills);
                await CharApi.UpdateAsync(_character);
            }
        }
    }

    // ── INVENTORY LOGIC ──
    private GearItemDto? _draggedItem;
    private GearItemDto? _selectedItem;
    private GearItemDto? _selectedVehicle;

    private void ShowItemDetails(GearItemDto item) => _selectedItem = item;
    private void CloseItemDetails() => _selectedItem = null;

    private void ShowVehicleDetails(string? vehicleName)
    {
        if (string.IsNullOrEmpty(vehicleName) || _character == null) return;
        _selectedVehicle = _character.Inventory.FirstOrDefault(i => i.Name == vehicleName);
    }
    private void CloseVehicleDetails() => _selectedVehicle = null;

    private void HandleDragStart(GearItemDto item)
    {
        _draggedItem = item;
    }

    private async Task HandleDrop(string targetZone)
    {
        if (_draggedItem == null || _character == null) return;

        // Validation
        bool isWeapon = _draggedItem.Category == "Weapon";
        bool isArmor = _draggedItem.Category == "Armor" || _draggedItem.Category == "Clothing";
        bool isVehicle = _draggedItem.Category == "Vehicle";

        if (targetZone == "WEAPON" && !isWeapon) return;
        if (targetZone == "VEHICLE_SLOT" && !isVehicle) return;
        if ((targetZone == "HEAD" || targetZone == "TORSO" || targetZone == "R.ARM" || targetZone == "L.ARM" || targetZone == "R.LEG" || targetZone == "L.LEG" || targetZone.EndsWith("_OUTER")) && !isArmor) return;
        if (targetZone == "VEHICLE" && isVehicle) return; // Can't put a vehicle in a vehicle trunk

        // Remove from current equip slot if it's equipped
        if (_character.EquippedGearIds.ContainsValue(_draggedItem.InstanceId))
        {
            var key = _character.EquippedGearIds.FirstOrDefault(x => x.Value == _draggedItem.InstanceId).Key;
            _character.EquippedGearIds.Remove(key);
        }

        // Add to new zone if it's an equip slot
        if (targetZone != "BACKPACK" && targetZone != "VEHICLE")
        {
            _character.EquippedGearIds[targetZone] = _draggedItem.InstanceId;
        }
        else
        {
            if (targetZone == "VEHICLE")
                _character.GridItemPositions[_draggedItem.InstanceId] = -1; // -1 means vehicle
            else
                _character.GridItemPositions.Remove(_draggedItem.InstanceId); // removed means backpack
        }

        await CharApi.UpdateAsync(_character);
        _draggedItem = null;
        StateHasChanged();
    }

    private bool HasEquipped(string slot) => _character?.EquippedGearIds.ContainsKey(slot) == true;
    
    private string? GetEquippedName(string slot)
    {
        if (_character == null || !_character.EquippedGearIds.TryGetValue(slot, out var id)) return null;
        return _character.Inventory.FirstOrDefault(i => i.InstanceId == id)?.Name;
    }

    private IEnumerable<GearItemDto> GetItemsInZone(string zone)
    {
        if (_character == null) return Enumerable.Empty<GearItemDto>();
        
        var unequipped = _character.Inventory.Where(i => !_character.EquippedGearIds.ContainsValue(i.InstanceId));
        
        if (zone == "VEHICLE")
            return unequipped.Where(i => _character.GridItemPositions.GetValueOrDefault(i.InstanceId, 0) == -1);
        else // BACKPACK
            return unequipped.Where(i => _character.GridItemPositions.GetValueOrDefault(i.InstanceId, 0) != -1);
    }

    private double GetWeight(string zone) => GetItemsInZone(zone).Sum(i => i.WeightKg);

    private int GetItemSpan(GearItemDto item)
    {
        int cells = (int)Math.Ceiling(item.WeightKg / 0.5);
        return Math.Max(1, Math.Min(10, cells)); // max span 10 columns
    }

    private string GetItemClass(GearItemDto item) => item.Category.ToLower() switch
    {
        "weapon" => "cat-weapon",
        "armor" => "cat-armor",
        "medical" => "cat-medical",
        "tool" or "equipment" => "cat-tool",
        "drug" => "cat-drug",
        "vehicle" => "cat-vehicle",
        "cyberware" => "cat-cyber",
        _ => ""
    };

    private string GetItemIcon(GearItemDto item) => item.Category.ToLower() switch
    {
        "weapon" => "⚔",
        "armor" => "⛨",
        "medical" => "✚",
        "tool" or "equipment" => "⚙",
        "drug" => "⚗",
        "vehicle" => "⛟",
        "cyberware" => "⬡",
        _ => "📦"
    };
}