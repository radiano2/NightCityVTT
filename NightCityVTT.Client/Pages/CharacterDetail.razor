@page "/characters/{Id}"
@using NightCityVTT.Shared.Models
@using NightCityVTT.Client.Services
@using System.Text.Json
@inject CharacterApiService CharApi
@inject UserSessionService Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject DiceEngine Dice
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>@(_character?.Handle?.ToUpper() ?? "Loading Dossier...")</PageTitle>

@if (_loading)
{
    <div class="ncc-loading">
        <div class="ncc-empty-icon">⬡</div>
        <div class="ncc-empty-sub">ACCESSING SECURE DOSSIER...</div>
    </div>
}
else if (_character == null)
{
    <div class="ncc-empty">
        <div class="ncc-empty-icon">✕</div>
        <div>DOSSIER NOT FOUND OR CORRUPTED</div>
        <button class="ncc-btn-submit" style="margin-top: 1rem;" @onclick='() => Nav.NavigateTo("/characters", forceLoad: true)'>RETURN TO REGISTRY</button>
    </div>
}
else
{
    <div class="detail-page-layout">
        <!-- HEADER -->
        <div class="dp-header">
            <div style="display:flex; align-items:center; gap: 2rem;">
                <button class="back-btn" @onclick='() => Nav.NavigateTo("/characters", forceLoad: true)'>◁ BACK</button>
                <div class="dp-title-block">
                    <h1>@_character.Handle.ToUpper()</h1>
                    <div class="dp-role">@_character.Role // @_character.SpecialAbility</div>
                </div>
            </div>
            <div class="dp-meta">
                <span class="funds">FUNDS: €$@_character.Eurobucks</span>
                @if (Session.CurrentUser?.Role == UserRole.GameMaster && !string.IsNullOrEmpty(_character.OwnerId))
                {
                    <span class="owner">OPERATOR: @_character.OwnerId</span>
                }
            </div>
        </div>

        <!-- 16:9 2-COLUMN CONTENT -->
        <div class="dp-content-grid">
            
            <!-- LEFT COLUMN: Stats & Lifepath -->
            <div class="dp-col-left">
                <div class="dp-section">
                    <h3>NEURAL & PHYSICAL STATS</h3>
                    <div class="dp-stats">
                        <div class="stat-chip">INT: @_character.INT</div>
                        <div class="stat-chip @(TotalEV > 0 ? "stat-penalized" : "")" title="@(TotalEV > 0 ? $"-{TotalEV} EV Penalty" : "")">
                            REF: @Math.Max(1, _character.REF - TotalEV) @(TotalEV > 0 ? $" (-{TotalEV})" : "")
                        </div>
                        <div class="stat-chip">TECH: @_character.TECH</div>
                        <div class="stat-chip">COOL: @_character.COOL</div>
                        <div class="stat-chip lk-chip" style="cursor:pointer; display:flex; align-items:center; gap:0.2rem;" title="Left-click to spend luck, Right-click to restore">
                            <button style="background:transparent; border:none; color:var(--nc-cyan); cursor:pointer; font-weight:bold; font-size:1.1rem;" @onclick="DecrementLuck" @onclick:preventDefault>-</button>
                            LK: @_character.CurrentLuck / @_character.LK
                            <button style="background:transparent; border:none; color:var(--nc-cyan); cursor:pointer; font-weight:bold; font-size:1.1rem;" @onclick="IncrementLuck" @onclick:preventDefault>+</button>
                        </div>
                        <div class="stat-chip">ATT: @_character.ATT</div>
                        <div class="stat-chip">MA: @_character.MA</div>
                        <div class="stat-chip">EMP: @_character.EMP</div>
                        <div class="stat-chip">BT: @_character.BT</div>
                    </div>
                    <div class="dp-derived">
                        <div class="der-row"><span>MOBILITY</span> <strong>@_character.Mobility</strong></div>
                        <div class="der-row"><span>RESILIENCE</span> <strong>@_character.Resilience</strong></div>
                    </div>

                    <!-- HUMANITY PANEL -->
                    <div class="humanity-panel @HumanityClass">
                        @if (_character.Humanity == 0)
                        {
                            <div class="cyberpsycho-banner">// CYBERPSYCHOSIS THRESHOLD BREACHED // OPERATOR RECLASSIFIED AS HOSTILE //</div>
                        }
                        <div class="hu-header">
                            <span class="hu-label">HUMANITY INDEX</span>
                            <span class="hu-status @HumanityClass">@HumanityStatus</span>
                        </div>
                        <div class="hu-bar-track">
                            <div class="hu-bar-fill @HumanityClass" style="width: @_character.Humanity%"></div>
                        </div>
                        <div class="hu-numbers">
                            <span class="hu-val">@_character.Humanity <span style="color:var(--nc-dim); font-size:0.7rem;">/ 100</span></span>
                            <span class="hu-emp">EMP: <strong>@(_character.Humanity / 10)</strong></span>
                        </div>
                        @if (_character.InstalledCyberwareIds.Count > 0)
                        {
                            <div style="font-size:0.65rem; color:var(--nc-dim); margin-top:0.4rem; letter-spacing:0.08em;">
                                @_character.InstalledCyberwareIds.Count IMPLANT(S) ACTIVE
                            </div>
                        }
                    </div>
                </div>

                <div class="dp-section">
                    <h3>LIFEPATH PROTOCOL</h3>
                    <div class="lp-grid">
                        <div class="lp-item"><span>ORIGIN</span><strong>@_character.EthnicOrigin</strong></div>
                        <div class="lp-item"><span>STYLE</span><strong>@_character.Clothes, @_character.Hairstyle, @_character.Affectation</strong></div>
                        <div class="lp-item"><span>FAMILY</span><strong>@_character.FamilyRanking — @_character.FamilyTragedy</strong></div>
                        <div class="lp-item"><span>PERSONALITY</span><strong>@_character.PersonalityTrait</strong></div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_character.SkillsJson))
                {
                    var skills = JsonSerializer.Deserialize<Dictionary<string,int>>(_character.SkillsJson) ?? new();
                    if (skills.Count > 0)
                    {
                        <div class="dp-section" style="flex: 1; display:flex; flex-direction:column;">
                            <h3 style="display:flex; justify-content:space-between; align-items:center;">
                                SKILL MATRIX
                                <span style="color:var(--nc-cyan)">IP: @_character.IP</span>
                            </h3>
                            <div class="skills-list">
                                @foreach (var kv in skills.Where(k => k.Value > 0).OrderByDescending(k => k.Value))
                                {
                                    <div class="skill-row" style="display:flex; justify-content:space-between; align-items:center;">
                                        <span>@kv.Key</span>
                                        <div style="display:flex; gap:0.5rem; align-items:center;">
                                            <span class="skill-val">@kv.Value</span>
                                            <button class="ncc-btn-submit" style="padding:0.1rem 0.3rem; font-size:0.5rem" 
                                                    title="Upgrade (@(kv.Value == 0 ? 10 : kv.Value * 10) IP)"
                                                    disabled="@(_character.IP < (kv.Value == 0 ? 10 : kv.Value * 10) || kv.Value >= 10)"
                                                    @onclick="() => UpgradeSkill(kv.Key)">
                                                +
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- RIGHT COLUMN: Inventory & Paper Doll -->
            <div class="dp-col-right">

                <!-- CYBERWARE BAY -->
                <div class="dp-section cyber-bay-section" ondragover="event.preventDefault()" @ondrop="HandleCyberDrop">
                    <h3>CYBERWARE BAY
                        <span style="font-size:0.65rem; color:var(--nc-dim); font-weight:normal; margin-left:0.5rem;">drag cyberware here to install</span>
                    </h3>

                    @if (!string.IsNullOrEmpty(_installLog))
                    {
                        <div class="install-log @(_installSuccess ? "log-ok" : "log-cost")" @onclick="() => _installLog = string.Empty">
                            @_installLog <span style="opacity:0.5; font-size:0.7rem; margin-left:0.5rem;">[click to dismiss]</span>
                        </div>
                    }

                    @if (_character.InstalledCyberwareIds.Count == 0)
                    {
                        <div class="cyber-empty">NO IMPLANTS DETECTED // DRAG CYBERWARE FROM INVENTORY TO INSTALL</div>
                    }
                    else
                    {
                        <div class="cyber-list">
                            @foreach (var instanceId in _character.InstalledCyberwareIds)
                            {
                                var item = _character.Inventory.FirstOrDefault(i => i.InstanceId == instanceId);
                                if (item == null) continue;
                                var cost = _character.HumanityPaidByInstanceId.GetValueOrDefault(instanceId, 0);
                                <div class="cyber-item">
                                    <div class="ci-icon">⬡</div>
                                    <div class="ci-info">
                                        <div class="ci-name">@item.Name.ToUpper()</div>
                                        <div class="ci-cost">HUMANITY COST: <span style="color:var(--nc-red);">–@cost</span></div>
                                    </div>
                                    <button class="ci-remove" title="Uninstall" @onclick="() => UninstallCyberware(item)">REMOVE</button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="dp-section" style="height: 100%; display: flex; flex-direction: column;">
                    <h3>LOADOUT & INVENTORY</h3>
                    
                    <div class="inv-system">
                        <div class="inv-paper-doll">
                            <h3 style="color:var(--nc-cyan); font-size:0.8rem; text-align:center; margin-bottom:1rem;">EQUIPPED GEAR</h3>
                            <div class="paper-doll">
                                <div class="pd-head @(HasEquipped("HEAD") ? "filled" : "")" 
                                     ondragover="event.preventDefault()" 
                                     @ondrop='() => HandleDrop("HEAD")'>
                                    @(GetEquippedName("HEAD") ?? "HEAD")
                                </div>
                                <div class="pd-head @(HasEquipped("HEAD_OUTER") ? "filled" : "")" 
                                     ondragover="event.preventDefault()" 
                                     @ondrop='() => HandleDrop("HEAD_OUTER")' style="margin-top:2px;">
                                    @(GetEquippedName("HEAD_OUTER") ?? "HEAD (OUTER)")
                                </div>
                                <div class="pd-mid">
                                    <div style="display:flex; flex-direction:column; gap:2px;">
                                        <div class="pd-arm @(HasEquipped("R.ARM") ? "filled" : "")" 
                                             ondragover="event.preventDefault()" 
                                             @ondrop='() => HandleDrop("R.ARM")'>
                                            @(GetEquippedName("R.ARM") ?? "R.ARM")
                                        </div>
                                        <div class="pd-arm @(HasEquipped("R.ARM_OUTER") ? "filled" : "")" 
                                             ondragover="event.preventDefault()" 
                                             @ondrop='() => HandleDrop("R.ARM_OUTER")'>
                                            @(GetEquippedName("R.ARM_OUTER") ?? "R.ARM (O)")
                                        </div>
                                    </div>
                                    
                                    <div style="display:flex; flex-direction:column; gap:2px;">
                                        <div class="pd-torso @(HasEquipped("TORSO") ? "filled" : "")" 
                                             ondragover="event.preventDefault()" 
                                             @ondrop='() => HandleDrop("TORSO")'>
                                            @(GetEquippedName("TORSO") ?? "TORSO")
                                        </div>
                                        <div class="pd-torso @(HasEquipped("TORSO_OUTER") ? "filled" : "")" 
                                             ondragover="event.preventDefault()" 
                                             @ondrop='() => HandleDrop("TORSO_OUTER")'>
                                            @(GetEquippedName("TORSO_OUTER") ?? "TORSO (OUTER)")
                                        </div>
                                    </div>

                                    <div style="display:flex; flex-direction:column; gap:2px;">
                                        <div class="pd-arm @(HasEquipped("L.ARM") ? "filled" : "")" 
                                             ondragover="event.preventDefault()" 
                                             @ondrop='() => HandleDrop("L.ARM")'>
                                            @(GetEquippedName("L.ARM") ?? "L.ARM")
                                        </div>
                                        <div class="pd-arm @(HasEquipped("L.ARM_OUTER") ? "filled" : "")" 
                                             ondragover="event.preventDefault()" 
                                             @ondrop='() => HandleDrop("L.ARM_OUTER")'>
                                            @(GetEquippedName("L.ARM_OUTER") ?? "L.ARM (O)")
                                        </div>
                                    </div>
                                </div>
                                <div class="pd-legs">
                                    <div style="display:flex; flex-direction:column; gap:2px;">
                                        <div class="pd-leg @(HasEquipped("R.LEG") ? "filled" : "")" 
                                             ondragover="event.preventDefault()" 
                                             @ondrop='() => HandleDrop("R.LEG")'>
                                            @(GetEquippedName("R.LEG") ?? "R.LEG")
                                        </div>
                                        <div class="pd-leg @(HasEquipped("R.LEG_OUTER") ? "filled" : "")" 
                                             ondragover="event.preventDefault()" 
                                             @ondrop='() => HandleDrop("R.LEG_OUTER")'>
                                            @(GetEquippedName("R.LEG_OUTER") ?? "R.LEG (O)")
                                        </div>
                                    </div>

                                    <div style="display:flex; flex-direction:column; gap:2px;">
                                        <div class="pd-leg @(HasEquipped("L.LEG") ? "filled" : "")" 
                                             ondragover="event.preventDefault()" 
                                             @ondrop='() => HandleDrop("L.LEG")'>
                                            @(GetEquippedName("L.LEG") ?? "L.LEG")
                                        </div>
                                        <div class="pd-leg @(HasEquipped("L.LEG_OUTER") ? "filled" : "")" 
                                             ondragover="event.preventDefault()" 
                                             @ondrop='() => HandleDrop("L.LEG_OUTER")'>
                                            @(GetEquippedName("L.LEG_OUTER") ?? "L.LEG (O)")
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="pd-weapon @(HasEquipped("WEAPON") ? "filled" : "")" style="margin-top:0.5rem; width:100%; height:30px; border:1px dashed var(--nc-gold); display:flex; align-items:center; justify-content:center; font-size:0.6rem; color:var(--nc-gold);"
                                     ondragover="event.preventDefault()" 
                                     @ondrop='() => HandleDrop("WEAPON")'>
                                    @(GetEquippedName("WEAPON") ?? "WEAPON SLOT")
                                </div>
                                <div class="pd-vehicle @(HasEquipped("VEHICLE_SLOT") ? "filled" : "")" style="margin-top:0.5rem; width:100%; height:30px; border:1px dashed #f472b6; display:flex; align-items:center; justify-content:center; font-size:0.6rem; color:#f472b6;"
                                     ondragover="event.preventDefault()" 
                                     @ondrop='() => HandleDrop("VEHICLE_SLOT")'>
                                    @(GetEquippedName("VEHICLE_SLOT") ?? "VEHICLE SLOT")
                                </div>
                                @if (HasEquipped("VEHICLE_SLOT"))
                                {
                                    <button class="ncc-btn-submit" style="margin-top: 0.5rem; font-size: 0.6rem; width: 100%;" @onclick='() => ShowVehicleDetails(GetEquippedName("VEHICLE_SLOT"))'>VIEW VEHICLE</button>
                                }
                            </div>
                        </div>

                        <div class="inv-grids">
                            <div class="inv-grid-section" ondragover="event.preventDefault()" @ondrop='() => HandleDrop("BACKPACK")'>
                                <div class="inv-header">
                                    <span class="lbl">BACKPACK // CARRY CAP: @(_character.BT * 10) KG</span>
                                    <span class="val">@GetWeight("BACKPACK") / @(_character.BT * 10) KG</span>
                                </div>
                                <div class="grid-container" style="--max-cells: @(_character.BT * 20);">
                                    @foreach (var item in GetItemsInZone("BACKPACK"))
                                    {
                                        <div class="grid-item @GetItemClass(item)" 
                                             style="--span: @GetItemSpan(item);" 
                                             draggable="true" 
                                             @ondragstart='() => HandleDragStart(item)'
                                             @onclick='() => ShowItemDetails(item)'>
                                            <span class="icon">@GetItemIcon(item)</span>
                                            <span class="name">@item.Name</span>
                                            <span class="weight">@item.WeightKg kg</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (HasEquipped("VEHICLE_SLOT"))
                            {
                                <div class="inv-grid-section" style="margin-top: 1rem;" ondragover="event.preventDefault()" @ondrop='() => HandleDrop("VEHICLE")'>
                                    <div class="inv-header" style="color:var(--nc-cyan);">
                                        <span class="lbl">VEHICLE TRUNK // CAP: 500 KG</span>
                                        <span class="val">@GetWeight("VEHICLE") / 500 KG</span>
                                    </div>
                                    <div class="grid-container" style="--max-cells: 1000;">
                                        @foreach (var item in GetItemsInZone("VEHICLE"))
                                        {
                                            <div class="grid-item @GetItemClass(item)" 
                                                 style="--span: @GetItemSpan(item);" 
                                                 draggable="true" 
                                                 @ondragstart='() => HandleDragStart(item)'
                                                 @onclick='() => ShowItemDetails(item)'>
                                                <span class="icon">@GetItemIcon(item)</span>
                                                <span class="name">@item.Name</span>
                                                <span class="weight">@item.WeightKg kg</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ITEM POPUP -->
@if (_selectedItem != null)
{
    <div class="detail-overlay" @onclick="CloseItemDetails">
        <div class="detail-box" style="max-width: 400px; border-color: var(--nc-cyan);" @onclick:stopPropagation="true">
            <button class="detail-close" style="color: var(--nc-cyan);" @onclick="CloseItemDetails">✕</button>
            <h2 style="color: var(--nc-cyan); margin-bottom: 0.5rem; border-bottom: 1px solid var(--nc-border); padding-bottom: 0.5rem;">@_selectedItem.Name.ToUpper()</h2>
            <div style="font-size: 0.8rem; color: var(--nc-dim); margin-bottom: 1rem;">
                <span style="color: var(--nc-gold);">@_selectedItem.Category.ToUpper()</span> // WGT: @_selectedItem.WeightKg KG // COST: €$@_selectedItem.CostEurobucks
            </div>
            <p style="font-size: 0.9rem; color: var(--nc-cream); line-height: 1.5; margin-bottom: 1.5rem;">@_selectedItem.Description</p>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; font-size: 0.8rem; background: rgba(0,0,0,0.3); padding: 1rem; border: 1px dashed var(--nc-border);">
                @if (!string.IsNullOrEmpty(_selectedItem.Damage)) { <div><strong style="color:var(--nc-red);">DMG:</strong> @_selectedItem.Damage</div> }
                @if (!string.IsNullOrEmpty(_selectedItem.Acc)) { <div><strong style="color:var(--nc-cyan);">ACC:</strong> @_selectedItem.Acc</div> }
                @if (!string.IsNullOrEmpty(_selectedItem.Range)) { <div><strong style="color:var(--nc-dim);">RNG:</strong> @_selectedItem.Range</div> }
                @if (!string.IsNullOrEmpty(_selectedItem.Capacity)) { <div><strong style="color:var(--nc-dim);">CAP:</strong> @_selectedItem.Capacity</div> }
                @if (!string.IsNullOrEmpty(_selectedItem.ROF)) { <div><strong style="color:var(--nc-dim);">ROF:</strong> @_selectedItem.ROF</div> }
                @if (!string.IsNullOrEmpty(_selectedItem.SP)) { <div><strong style="color:var(--nc-cyan);">SP:</strong> @_selectedItem.SP</div> }
                @if (!string.IsNullOrEmpty(_selectedItem.EV)) { <div><strong style="color:var(--nc-dim);">EV:</strong> @_selectedItem.EV</div> }
                @if (!string.IsNullOrEmpty(_selectedItem.Concealability)) { <div><strong style="color:var(--nc-dim);">CONC:</strong> @_selectedItem.Concealability</div> }
                @if (!string.IsNullOrEmpty(_selectedItem.Availability)) { <div><strong style="color:var(--nc-dim);">AVAIL:</strong> @_selectedItem.Availability</div> }
            </div>
        </div>
    </div>
}

<!-- VEHICLE DIAGRAM POPUP -->
@if (_selectedVehicle != null)
{
    <div class="detail-overlay" @onclick="CloseVehicleDetails">
        <div class="detail-box" style="border-color: #f472b6; max-width: 800px;" @onclick:stopPropagation="true">
            <button class="detail-close" style="color: #f472b6;" @onclick="CloseVehicleDetails">✕</button>
            <h2 style="color: #f472b6; margin-bottom: 0.5rem; border-bottom: 1px solid var(--nc-border); padding-bottom: 0.5rem;">@_selectedVehicle.Name.ToUpper() DIAGRAM</h2>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1rem;">
                <div>
                    <div style="font-size: 0.8rem; color: var(--nc-dim); margin-bottom: 1rem;">
                        <span style="color: var(--nc-gold);">VEHICLE</span> // WGT: @_selectedVehicle.WeightKg KG // COST: €$@_selectedVehicle.CostEurobucks
                    </div>
                    <p style="font-size: 0.9rem; color: var(--nc-cream); line-height: 1.5; margin-bottom: 1.5rem;">@_selectedVehicle.Description</p>
                    
                    <div style="display: grid; grid-template-columns: 1fr; gap: 0.5rem; font-size: 0.8rem; background: rgba(0,0,0,0.3); padding: 1rem; border: 1px dashed var(--nc-border);">
                        @if (!string.IsNullOrEmpty(_selectedVehicle.TopSpeed)) { <div><strong style="color:var(--nc-cyan);">TOP SPEED:</strong> @_selectedVehicle.TopSpeed</div> }
                        @if (!string.IsNullOrEmpty(_selectedVehicle.Seats)) { <div><strong style="color:var(--nc-dim);">SEATS:</strong> @_selectedVehicle.Seats</div> }
                        @if (!string.IsNullOrEmpty(_selectedVehicle.SDP)) { <div><strong style="color:var(--nc-red);">STRUCTURAL DAMAGE POINTS (SDP):</strong> @_selectedVehicle.SDP</div> }
                        <div><strong style="color:var(--nc-gold);">TRUNK CAPACITY:</strong> 500 KG</div>
                    </div>
                </div>
                
                <div style="border: 1px solid var(--nc-border); padding: 1rem; display: flex; align-items: center; justify-content: center; background: rgba(244, 114, 182, 0.05);">
                    <div style="text-align: center; color: #f472b6; font-family: var(--font-mono); font-size: 0.8rem;">
                        <pre style="margin:0; opacity:0.7;">
      .--------.
 ____/_______\___
/  _   _   _   _ \
| | | | | | | | | |
| '-` '-` '-` '-` |
 \________________/
    (O)      (O)
                        </pre>
                        <div style="margin-top: 1rem;">[ SCHEMATIC RENDER ]</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .detail-page-layout { padding: 2rem; max-width: 1600px; margin: 0 auto; color: var(--nc-cream); font-family: var(--font-mono); min-height: 80vh; display: flex; flex-direction: column; }
    
    .dp-header { border-bottom: 2px solid var(--nc-red); padding-bottom: 1rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-end; }
    .back-btn { background: transparent; border: 1px solid var(--nc-border); color: var(--nc-dim); padding: 0.5rem 1rem; cursor: pointer; font-family: var(--font-mono); transition: all 0.2s; }
    .back-btn:hover { color: var(--nc-cyan); border-color: var(--nc-cyan); }
    .dp-title-block h1 { font-family: var(--font-display); font-size: 2.5rem; color: var(--nc-red); margin: 0 0 0.2rem 0; letter-spacing: 0.1em; }
    .dp-role { color: var(--nc-cyan); font-weight: bold; letter-spacing: 0.2em; font-size: 0.9rem; }
    .dp-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 0.5rem; }
    .funds { font-size: 1.5rem; color: var(--nc-gold); font-weight: bold; font-family: var(--font-display); }
    .owner { font-size: 0.7rem; color: var(--nc-dim); letter-spacing: 0.1em; }

    .dp-content-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: 2rem; flex: 1; }

    .dp-col-left { display: flex; flex-direction: column; gap: 1.5rem; }
    .dp-col-right { display: flex; flex-direction: column; }

    .dp-section { background: var(--nc-panel); border: 1px solid var(--nc-border); padding: 1.5rem; position: relative; border-left: 4px solid var(--nc-cyan); }
    .dp-section h3 { color: var(--nc-cyan); font-size: 1rem; letter-spacing: 0.1em; border-bottom: 1px dashed var(--nc-border); padding-bottom: 0.5rem; margin-bottom: 1rem; }

    .dp-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); gap: 0.5rem; margin-bottom: 1rem; }
    .stat-chip { background: var(--nc-dark); border: 1px solid var(--nc-border); padding: 0.5rem; text-align: center; font-size: 0.8rem; color: var(--nc-cream); }
    
