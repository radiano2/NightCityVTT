@page "/scenarios/{ScenarioId}"
@inject ScenarioApiService ScenarioApi
@inject MapApiService MapApi
@inject CharacterApiService CharApi
@inject UserSessionService Session
@inject NavigationManager Nav
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>@(_scenario?.Name ?? "Operation") // Night City VTT</PageTitle>

<div class="maps-page">
    @if (_loading)
    {
        <div class="ncc-loading">
            <div class="ncc-empty-icon">⬡</div>
            <div class="ncc-empty-sub">LOADING OPERATION...</div>
        </div>
    }
    else if (_scenario is null)
    {
        <div class="ncc-empty">
            <div class="ncc-empty-icon">◌</div>
            <div class="ncc-empty-sub">OPERATION NOT FOUND</div>
            <button class="ncc-btn-submit" @onclick='() => Nav.NavigateTo("/scenarios")'>BACK</button>
        </div>
    }
    else
    {
        <div class="sd-header">
            <button class="bm-back-btn" @onclick='() => Nav.NavigateTo("/scenarios")'>◁ OPERATIONS</button>
            <div>
                <input class="ncc-input sd-name-input" @bind="_scenario.Name" placeholder="Operation name..." />
                <select class="ncc-select" @bind="_scenario.Status" style="width:140px">
                    <option value="Active">Active</option>
                    <option value="Completed">Completed</option>
                    <option value="Archived">Archived</option>
                </select>
            </div>
            <button class="ncc-btn-submit" @onclick="Save">SAVE</button>
            @if (!string.IsNullOrEmpty(_scenario.MapId))
            {
                <button class="ncc-btn-submit" style="background:var(--nc-red)" @onclick="Launch">▶ LAUNCH</button>
            }
        </div>

        <div class="sd-body">

            <!-- Description -->
            <div class="sd-section">
                <div class="sd-section-title">BRIEF</div>
                <textarea class="ncc-input sd-desc" @bind="_scenario.Description" placeholder="Mission description..."></textarea>
            </div>

            <!-- Link Map -->
            <div class="sd-section">
                <div class="sd-section-title">LINKED MAP</div>
                <select class="ncc-select" @bind="_scenario.MapId" style="max-width:320px">
                    <option value="">— NO MAP —</option>
                    @foreach (var m in _maps)
                    {
                        <option value="@m.Id">@m.Name.ToUpper() (@m.Width×@m.Height)</option>
                    }
                </select>
            </div>

            <!-- Teams -->
            <div class="sd-section">
                <div class="sd-section-title">TEAMS</div>
                @foreach (var team in _scenario.Teams)
                {
                    <div class="sd-team-block">
                        <div class="sd-team-header">
                            <div class="bm-token-dot" style="background:@team.Color"></div>
                            <input class="ncc-input sd-team-name" @bind="team.Name" placeholder="Team name" />
                            <input type="color" @bind="team.Color" class="bm-team-color-pick" />
                            <label class="bm-team-player-lbl">
                                <input type="checkbox" @bind="team.IsPlayerSide" />
                                <span>Player side</span>
                            </label>
                            <button class="bm-remove-btn" @onclick="() => _scenario.Teams.Remove(team)">✕</button>
                        </div>
                        <!-- Members -->
                        <div class="sd-members">
                            @foreach (var charId in team.MemberCharacterIds)
                            {
                                var ch = _allChars.FirstOrDefault(c => c.Id == charId);
                                <div class="sd-member-row">
                                    <span>@(ch?.Handle.ToUpper() ?? charId) (@(ch?.Role ?? "?"))</span>
                                    <button class="bm-remove-btn" @onclick="() => team.MemberCharacterIds.Remove(charId)">✕</button>
                                </div>
                            }
                            <select class="ncc-select sd-add-char" @onchange="e => AddCharToTeam(team, e.Value?.ToString())">
                                <option value="">+ add character...</option>
                                @foreach (var c in _allChars.Where(c => !_scenario.Teams.Any(t => t.MemberCharacterIds.Contains(c.Id ?? ""))))
                                {
                                    <option value="@c.Id">@c.Handle.ToUpper() (@c.Role)</option>
                                }
                            </select>
                        </div>
                    </div>
                }
                <button class="ncc-btn-submit sd-add-team-btn" @onclick="AddTeam">+ ADD TEAM</button>
            </div>

        </div>
    }
</div>

@code {
    [Parameter] public string ScenarioId { get; set; } = "";

    private ScenarioDto?           _scenario;
    private List<MapDto>           _maps     = new();
    private List<CharacterSheet>   _allChars = new();
    private bool _loading = true;
    private bool _isGm;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        _isGm = Session.CurrentUser?.Role == UserRole.GameMaster;
        _scenario = await ScenarioApi.GetByIdAsync(ScenarioId);
        _maps     = await MapApi.GetAllAsync();
        _allChars = await CharApi.GetAllAsync();
        _loading = false;
    }

    private async Task Save()
    {
        if (_scenario is null) return;
        await ScenarioApi.UpdateAsync(_scenario);
    }

    private async Task Launch()
    {
        if (_scenario?.Id is null) return;
        await Save();
        var mapUrl = await ScenarioApi.LaunchAsync(_scenario.Id);
        if (mapUrl != null) Nav.NavigateTo(mapUrl);
    }

    private void AddTeam()
    {
        _scenario?.Teams.Add(new ScenarioTeam { Name = "New Team", Color = "#3a9fff" });
    }

    private void AddCharToTeam(ScenarioTeam team, string? charId)
    {
        if (string.IsNullOrEmpty(charId)) return;
        if (!team.MemberCharacterIds.Contains(charId))
            team.MemberCharacterIds.Add(charId);
    }
}

<style>
    .sd-header { display:flex; align-items:center; gap:.8rem; padding:1rem; flex-wrap:wrap;
                 border-bottom:1px solid var(--nc-border); }
    .sd-name-input { width:240px; font-family:'Orbitron',monospace; font-size:.85rem; }
    .sd-body { padding:1rem; display:flex; flex-direction:column; gap:1.5rem; }
    .sd-section { background:var(--nc-card-bg); border:1px solid var(--nc-border); padding:1rem; }
    .sd-section-title { font-size:.65rem; letter-spacing:.15em; color:var(--nc-text-dim);
                        margin-bottom:.8rem; font-family:'Share Tech Mono',monospace; }
    .sd-desc { width:100%; min-height:80px; resize:vertical; }
    .sd-team-block { border:1px solid var(--nc-border); padding:.8rem; margin-bottom:.6rem; border-radius:2px; }
    .sd-team-header { display:flex; align-items:center; gap:.4rem; flex-wrap:wrap; margin-bottom:.5rem; }
    .sd-team-name { flex:1; min-width:120px; }
    .sd-members { padding-left:.5rem; }
    .sd-member-row { display:flex; align-items:center; justify-content:space-between; padding:.2rem 0;
                     font-size:.75rem; border-bottom:1px dotted rgba(255,255,255,.05); }
    .sd-add-char { width:100%; font-size:.7rem; margin-top:.4rem; }
    .sd-add-team-btn { font-size:.7rem; padding:.35rem .9rem; margin-top:.4rem; }
</style>
