@page "/maps"
@inject MapApiService MapApi
@inject UserSessionService Session
@inject NavigationManager Nav
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Battle Maps // Night City VTT</PageTitle>

<div class="maps-page">
    <div class="maps-header">
        <h1><span class="lang-en">// TACTICAL GRID //</span><span class="lang-uk">// ТАКТИЧНА СІТКА //</span></h1>
        <p class="subtitle"><span class="lang-en">Battle maps for combat encounters. GM creates and manages maps.</span><span class="lang-uk">Бойові карти для сутичок. Майстер гри створює та керує картами.</span></p>
    </div>

    @if (_loading)
    {
        <div class="ncc-loading">
            <div class="ncc-empty-icon">⬡</div>
            <div class="ncc-empty-sub"><span class="lang-en">LOADING GRID DATA...</span><span class="lang-uk">ЗАВАНТАЖЕННЯ ДАНИХ СІТКИ...</span></div>
        </div>
    }
    else
    {
        @if (_isGm)
        {
            <div class="map-create-panel">
                <h3><span class="lang-en">CREATE NEW MAP</span><span class="lang-uk">СТВОРИТИ НОВУ КАРТУ</span></h3>
                <div class="map-create-form">
                    <div class="wiz-field">
                        <label><span class="lang-en">MAP NAME</span><span class="lang-uk">НАЗВА КАРТИ</span></label>
                        <input class="ncc-input" @bind="_newName" placeholder="e.g. Scavenger Warehouse" />
                    </div>
                    <div class="wiz-field">
                        <label><span class="lang-en">WIDTH (tiles)</span><span class="lang-uk">ШИРИНА (тайли)</span></label>
                        <input type="number" class="ncc-input" @bind="_newWidth" min="10" max="50" />
                    </div>
                    <div class="wiz-field">
                        <label><span class="lang-en">HEIGHT (tiles)</span><span class="lang-uk">ВИСОТА (тайли)</span></label>
                        <input type="number" class="ncc-input" @bind="_newHeight" min="10" max="50" />
                    </div>
                    <div class="wiz-field">
                        <label><span class="lang-en">TILE SIZE (px)</span><span class="lang-uk">РОЗМІР ТАЙЛУ (px)</span></label>
                        <select class="ncc-select" @bind="_newTileSize">
                            <option value="32">32px — <span class="lang-en">large map</span><span class="lang-uk">велика карта</span></option>
                            <option value="40">40px — <span class="lang-en">standard</span><span class="lang-uk">стандарт</span></option>
                            <option value="48">48px — <span class="lang-en">detailed</span><span class="lang-uk">деталізована</span></option>
                        </select>
                    </div>
                    <button class="ncc-btn-submit" @onclick="CreateMap" disabled="@_creating">
                        @((MarkupString)(_creating ? "<span class=\"lang-en\">CREATING...</span><span class=\"lang-uk\">СТВОРЕННЯ...</span>" : "<span class=\"lang-en\">CREATE MAP ⊕</span><span class=\"lang-uk\">СТВОРИТИ КАРТУ ⊕</span>"))
                    </button>
                </div>
            </div>
        }

        @if (_maps.Count == 0)
        {
            <div class="ncc-empty">
                <div class="ncc-empty-icon">⬡</div>
                <div class="ncc-empty-sub"><span class="lang-en">NO MAPS FOUND — GM MUST CREATE A BATTLE MAP FIRST</span><span class="lang-uk">КАРТ НЕ ЗНАЙДЕНО — МГ МАЄ СТВОРИТИ БОЙОВУ КАРТУ</span></div>
            </div>
        }
        else
        {
            <div class="map-list">
                @foreach (var map in _maps)
                {
                    <div class="map-card @(map.IsActive ? "map-active" : "")">
                        <div class="map-card-info">
                            <div class="map-card-name">@map.Name.ToUpper()</div>
                            <div class="map-card-meta">@map.Width × @map.Height <span class="lang-en">TILES</span><span class="lang-uk">ТАЙЛІВ</span> · @(map.Width * map.TileSize)×@(map.Height * map.TileSize)px · @map.Tokens.Count <span class="lang-en">TOKENS</span><span class="lang-uk">ТОКЕНІВ</span></div>
                            @if (map.IsActive) { <div class="map-active-badge">● <span class="lang-en">ACTIVE</span><span class="lang-uk">АКТИВНА</span></div> }
                        </div>
                        <div class="map-card-actions">
                            <button class="ncc-btn-submit" @onclick="() => OpenMap(map.Id!)"><span class="lang-en">OPEN</span><span class="lang-uk">ВІДКРИТИ</span></button>
                            @if (_isGm)
                            {
                                <button class="ncc-btn-submit" style="background: var(--nc-accent2);" @onclick="() => ToggleActive(map)">
                                    @((MarkupString)(map.IsActive ? "<span class=\"lang-en\">DEACTIVATE</span><span class=\"lang-uk\">ДЕАКТИВУВАТИ</span>" : "<span class=\"lang-en\">SET ACTIVE</span><span class=\"lang-uk\">ЗРОБИТИ АКТИВНОЮ</span>"))
                                </button>
                                <button class="ncc-btn-danger" @onclick="() => DeleteMap(map.Id!)"><span class="lang-en">DELETE</span><span class="lang-uk">ВИДАЛИТИ</span></button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<MapDto> _maps = new();
    private bool _loading = true;
    private bool _isGm;
    private bool _creating;

    private string _newName     = "New Map";
    private int    _newWidth    = 20;
    private int    _newHeight   = 20;
    private int    _newTileSize = 40;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        _isGm  = Session.CurrentUser?.Role == UserRole.GameMaster;
        _maps  = await MapApi.GetAllAsync();
        _loading = false;
    }

    private void OpenMap(string id) => Nav.NavigateTo($"/maps/{id}");

    private async Task CreateMap()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        _creating = true;
        var created = await MapApi.CreateAsync(new MapDto {
            Name     = _newName.Trim(),
            Width    = _newWidth,
            Height   = _newHeight,
            TileSize = _newTileSize
        });
        if (created?.Id != null) Nav.NavigateTo($"/maps/{created.Id}");
        _creating = false;
    }

    private async Task ToggleActive(MapDto map)
    {
        // Deactivate all, then activate this one (or deactivate if already active)
        foreach (var m in _maps) m.IsActive = false;
        map.IsActive = !map.IsActive;
        await MapApi.UpdateAsync(map);
        _maps = await MapApi.GetAllAsync();
    }

    private async Task DeleteMap(string id)
    {
        await MapApi.DeleteAsync(id);
        _maps = _maps.Where(m => m.Id != id).ToList();
    }
}

<style>
    .maps-page        { max-width: 900px; padding: 2rem; }
    .maps-header h1   { font-family: 'Orbitron', monospace; color: var(--nc-red); margin-bottom: .3rem; }
    .maps-header .subtitle { color: var(--nc-text-dim); font-size: .8rem; margin-bottom: 2rem; }

    .map-create-panel { background: var(--nc-card-bg); border: 1px solid var(--nc-border); padding: 1.5rem; margin-bottom: 2rem; }
    .map-create-panel h3 { font-family: 'Orbitron', monospace; color: var(--nc-accent2); margin-bottom: 1rem; font-size: .85rem; }
    .map-create-form  { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr auto; gap: 1rem; align-items: end; }

    .map-list         { display: flex; flex-direction: column; gap: 1rem; }
    .map-card         { background: var(--nc-card-bg); border: 1px solid var(--nc-border); padding: 1.2rem 1.5rem;
                        display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
    .map-card.map-active { border-color: var(--nc-green); }
    .map-card-name    { font-family: 'Orbitron', monospace; color: var(--nc-text); font-size: 1rem; }
    .map-card-meta    { color: var(--nc-text-dim); font-size: .75rem; margin-top: .2rem; }
    .map-active-badge { color: var(--nc-green); font-size: .7rem; margin-top: .3rem; letter-spacing: .12em; }
    .map-card-actions { display: flex; gap: .6rem; flex-shrink: 0; }
    .ncc-btn-danger   { background: transparent; border: 1px solid var(--nc-red); color: var(--nc-red);
                        padding: .4rem .8rem; font-size: .7rem; cursor: pointer; letter-spacing: .08em;
                        font-family: 'Share Tech Mono', monospace; transition: background .15s; }
    .ncc-btn-danger:hover { background: rgba(255,0,60,.15); }

    @@media (max-width: 700px) {
        .map-create-form { grid-template-columns: 1fr 1fr; }
        .map-card { flex-direction: column; align-items: flex-start; }
    }
</style>
