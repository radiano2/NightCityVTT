@page "/characters"
@using NightCityVTT.Shared.Models
@using NightCityVTT.Client.Services
@using System.Text.Json
@inject CharacterApiService CharApi
@inject UserSessionService Session
@inject UserApiService UserApi
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>
    <span class="lang-en hide-in-eec">Personnel Registry</span>
    <span class="lang-eec">Operative Dossiers</span>
    <span class="lang-ru">Картотека кадров</span>
    <span class="lang-pl">Rejestr personelu</span>
</PageTitle>

<div class="char-suite">
    @if (!_isCreating)
    {
        <!-- ═══ ROSTER VIEW ═══ -->
        <div class="roster-header" style="display:flex; flex-direction:column; gap:1.5rem; align-items:flex-start; margin-bottom: 2rem;">
            <div>
                <h1 class="lang-en hide-in-eec" style="margin:0;">PERSONNEL REGISTRY</h1>
                <h1 class="lang-eec" style="margin:0;">OPERATIVE DOSSIERS</h1>
                <h1 class="lang-ru" style="margin:0;">КАРТОТЕКА КАДРОВ</h1>
                <h1 class="lang-pl" style="margin:0;">REJESTR PERSONELU</h1>
            </div>
            
            <div style="display:flex; gap:1rem; align-items:center; width: 100%;">
                @if (Session.CurrentUser?.Role == UserRole.GameMaster)
                {
                    <select class="ncc-select" style="max-width:240px; padding: 0.5rem;" @bind="RosterFilter">
                        <option value="All">SHOW ALL ASSETS</option>
                        <option value="Players">PLAYER OPERATIVES</option>
                        <option value="Tests">TEST ASSETS</option>
                    </select>
                }
                <button class="ncc-btn-submit" @onclick="StartCreation" style="white-space:nowrap;">
                    <span class="lang-en hide-in-eec">NEW ASSET ⊕</span>
                    <span class="lang-eec">NEW OPERATIVE ⊕</span>
                    <span class="lang-ru">НОВЫЙ ОБЪЕКТ ⊕</span>
                    <span class="lang-pl">NOWY WPIS ⊕</span>
                </button>
            </div>
        </div>

        @if (_loading)
        {
            <div class="ncc-loading">
                <div class="ncc-empty-icon">⬡</div>
                <div class="ncc-empty-sub">SYNCING RECORDS...</div>
            </div>
        }
        else if (FilteredCharacters.Count == 0)
        {
            <div class="ncc-empty">
                <div class="ncc-empty-icon">◌</div>
                <div class="lang-en hide-in-eec">NO ASSETS ON RECORD</div>
                <div class="lang-eec">NO OPERATIVES DETECTED</div>
                <div class="lang-ru">ДАННЫЕ НЕ НАЙДЕНЫ</div>
                <div class="lang-pl">BRAK REKORDÓW</div>
            </div>
        }
        else
        {
            <div class="char-grid">
                @foreach (var c in FilteredCharacters)
                {
                    <div class="char-card @(c.Role.ToLower())" @onclick="() => ShowDetail(c)">
                        <div class="card-header">
                            <div>
                                <span class="card-handle">@c.Handle.ToUpper()</span>
                                @if (Session.CurrentUser?.Role == UserRole.GameMaster && !string.IsNullOrEmpty(c.OwnerId))
                                {
                                    <span class="card-owner">@(_userMap.TryGetValue(c.OwnerId, out var on) ? on : "unknown")</span>
                                }
                            </div>
                            <button class="card-del" @onclick:stopPropagation="true" @onclick="() => DeleteCharacter(c.Id!)">✕</button>
                        </div>
                        <div class="card-body">
                            <div class="card-role">@(string.IsNullOrEmpty(c.Role) ? "UNASSIGNED" : c.Role.ToUpper())</div>
                            <div class="card-stats">
                                <span>INT:@c.INT</span> <span>REF:@c.REF</span> <span>TECH:@c.TECH</span>
                            </div>
                        </div>
                        <div class="card-footer">
                            <span class="card-id">ID: @(c.Id?.Substring(Math.Max(0, c.Id.Length - 6)) ?? "---")</span>
                            <span class="card-date">@c.CreatedAt.ToString("yy.MM.dd")</span>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <!-- ═══ WIZARD VIEW ═══ -->
        <div class="wizard-container">
            <div class="wizard-header">
                <button class="wiz-back-btn" @onclick="CancelCreation">✕ EXIT</button>
                <div class="wiz-stepper">
                    @for (int i = 0; i < _stageLabels.Length; i++)
                    {
                        var idx = i;
                        <div class="wiz-step @(idx == _stage ? "active" : idx < _stage ? "done" : "")">
                            <span class="step-num">@(idx + 1)</span>
                            <span class="step-label">@_stageLabels[idx]</span>
                        </div>
                    }
                </div>
            </div>

            <div class="wizard-content">
                <!-- STAGE 0: IDENTITY -->
                @if (_stage == 0)
                {
                    <div class="wiz-section">
                        <h3>1. CORE IDENTIFICATION</h3>
                        <div class="wiz-field">
                            <label>HANDLE (STREET NAME) *</label>
                            <input type="text" class="ncc-input" @bind="_handle" placeholder="Enter codename..." />
                        </div>
                        <div class="wiz-field">
                            <label>LEGAL DESIGNATION (NAME)</label>
                            <input type="text" class="ncc-input" @bind="_name" placeholder="Optional..." />
                        </div>
                        <div class="wiz-field">
                            <label>ETHNIC ORIGIN</label>
                            <select class="ncc-select" @bind="_origin">
                                <option value="">— SELECT ORIGIN —</option>
                                @foreach (var o in _originOpts) { <option value="@o.V">@o.En</option> }
                            </select>
                        </div>
                    </div>
                }

                <!-- STAGE 1: ROLE -->
                @if (_stage == 1)
                {
                    <div class="wiz-section">
                        <h3>2. FUNCTIONAL ROLE</h3>
                        <div class="role-selector">
                            @foreach (var r in _roles)
                            {
                                <div class="role-card @(r.Name == _role ? "selected" : "")" @onclick="() => SelectRole(r)">
                                    <div class="role-name">@r.Name.ToUpper()</div>
                                    <div class="role-special">⊕ @r.Special</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- STAGE 2: STATS -->
                @if (_stage == 2)
                {
                    <div class="wiz-section">
                        <h3>3. CHARACTERISTICS</h3>
                        <div class="pool-header">
                            <span>REMAINING: <strong class="@(PointsRemaining < 0 ? "over" : "ok")">@PointsRemaining</strong> / @PointPool</span>
                            <label class="elite-toggle">
                                <input type="checkbox" @bind="_isElite" /> ELITE BUILD (80 PTS)
                            </label>
                        </div>
                        <div class="stats-grid">
                            @foreach (var s in _stats)
                            {
                                <div class="stat-row">
                                    <div class="stat-info">
                                        <span class="stat-name">@s.Key</span>
                                        <span class="stat-desc">@_statDescs[s.Key]</span>
                                    </div>
                                    <div class="skill-ctrl">
                                        <button @onclick="() => AdjStat(s.Key, -1)">-</button>
                                        <span class="skill-val" style="color:var(--nc-cyan);">@s.Value</span>
                                        <button @onclick="() => AdjStat(s.Key, 1)" disabled="@(PointsRemaining <= 0)">+</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- STAGE 3: LIFEPATH -->
                @if (_stage == 3)
                {
                    <div class="wiz-section">
                        <h3>4. LIFEPATH PROTOCOL</h3>
                        <div class="lifepath-grid">
                            <div class="wiz-field">
                                <label>CLOTHING STYLE</label>
                                <select class="ncc-select" @bind="_clothes">
                                    <option value="">— SELECT —</option>
                                    @foreach (var o in _clothesOpts) { <option value="@o.V">@o.En</option> }
                                </select>
                            </div>
                            <div class="wiz-field">
                                <label>HAIRSTYLE</label>
                                <select class="ncc-select" @bind="_hairstyle">
                                    <option value="">— SELECT —</option>
                                    @foreach (var o in _hairOpts) { <option value="@o.V">@o.En</option> }
                                </select>
                            </div>
                            <div class="wiz-field">
                                <label>AFFECTATION</label>
                                <select class="ncc-select" @bind="_affectation">
                                    <option value="">— SELECT —</option>
                                    @foreach (var o in _affectOpts) { <option value="@o.V">@o.En</option> }
                                </select>
                            </div>
                            <div class="wiz-field">
                                <label>FAMILY RANKING</label>
                                <select class="ncc-select" @bind="_familyRanking">
                                    <option value="">— SELECT —</option>
                                    @foreach (var o in _familyRankOpts) { <option value="@o.V">@o.En</option> }
                                </select>
                            </div>
                            <div class="wiz-field">
                                <label>FAMILY TRAGEDY</label>
                                <select class="ncc-select" @bind="_familyTragedy">
                                    <option value="">— SELECT —</option>
                                    @foreach (var o in _familyTragOpts) { <option value="@o.V">@o.En</option> }
                                </select>
                            </div>
                            <div class="wiz-field">
                                <label>PERSONALITY</label>
                                <select class="ncc-select" @bind="_personality">
                                    <option value="">— SELECT —</option>
                                    @foreach (var o in _personalityOpts) { <option value="@o.V">@o.En</option> }
                                </select>
                            </div>
                        </div>
                    </div>
                }

                <!-- STAGE 4: SKILLS -->
                @if (_stage == 4)
                {
                    <div class="wiz-section">
                        <h3>5. SKILL MATRIX</h3>
                        <div class="pool-bar">CAREER POINTS: <strong>@CareerPointsRemaining</strong> / 40</div>
                        <div class="skills-scroll">
                            @foreach (var skill in CurrentRole?.CareerSkills ?? Array.Empty<string>())
                            {
                                var val = _careerSkills.GetValueOrDefault(skill, 0);
                                <div class="skill-row">
                                    <div class="stat-info">
                                        <span class="skill-name @(skill == CurrentRole?.Special ? "special" : "")">
                                            @skill
                                            @if (skill == CurrentRole?.Special) { <span style="font-size:0.6rem; margin-left:0.5rem; background:var(--nc-gold); color:var(--nc-black); padding:2px 4px; border-radius:2px;">RECOMMENDED</span> }
                                        </span>
                                        <span class="stat-desc">@(_skillDescs.GetValueOrDefault(skill, "General skill."))</span>
                                    </div>
                                    <div class="skill-ctrl">
                                        <button @onclick="() => AdjSkill(_careerSkills, skill, -1)">-</button>
                                        <span class="skill-val">@val</span>
                                        <button @onclick="() => AdjSkill(_careerSkills, skill, 1)" disabled="@(CareerPointsRemaining <= 0 || val >= 10)">+</button>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="pool-bar" style="margin-top: 1rem;">PICKUP POINTS: <strong>@PickupPointsRemaining</strong> / @PickupPool</div>
                        <div class="skills-scroll">
                            @foreach (var skill in _pickupSkillNames)
                            {
                                var val = _pickupSkills.GetValueOrDefault(skill, 0);
                                <div class="skill-row">
                                    <div class="stat-info">
                                        <span class="skill-name">@skill</span>
                                        <span class="stat-desc">@(_skillDescs.GetValueOrDefault(skill, "General skill."))</span>
                                    </div>
                                    <div class="skill-ctrl">
                                        <button @onclick="() => AdjSkill(_pickupSkills, skill, -1)">-</button>
                                        <span class="skill-val">@val</span>
                                        <button @onclick="() => AdjSkill(_pickupSkills, skill, 1)" disabled="@(PickupPointsRemaining <= 0 || val >= 10)">+</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="wizard-footer">
                @if (!string.IsNullOrEmpty(_error)) { <div class="ncc-msg ncc-msg-err">✕ @_error</div> }
                <div class="wiz-nav">
                    <button class="wiz-btn" @onclick="PrevStage" disabled="@(_stage == 0)">BACK</button>
                    @if (_stage < 4)
                    {
                        <button class="wiz-btn primary" @onclick="NextStage" disabled="@(!CanAdvance)">NEXT</button>
                    }
                    else
                    {
                        <button class="wiz-btn primary" @onclick="SaveCharacter" disabled="@_saving">
                            @(_saving ? "SYNCING..." : "COMMIT TO NET ◈")
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>



<style>
    .char-suite { padding: 2rem; max-width: 1400px; margin: 0 auto; min-height: 80vh; }
    .roster-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--nc-border); padding-bottom: 1.5rem; margin-bottom: 2rem; }
    .roster-header h1 { font-family: var(--font-display); font-size: 2rem; color: var(--nc-red); margin: 0; letter-spacing: 0.1em; }

    /* GRID */
    .char-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
    .char-card { background: var(--nc-panel); border: 1px solid var(--nc-border); padding: 1rem; position: relative; cursor: pointer; transition: transform 0.2s, border-color 0.2s; border-left: 4px solid var(--nc-red); }
    .char-card:hover { transform: translateY(-4px); border-color: var(--nc-red); }
    .char-card.solo { border-left-color: #ff4444; }
    .char-card.netrunner { border-left-color: #00e5ff; }
    .char-card.techie { border-left-color: #f5c518; }
    
    .card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.8rem; }
    .card-handle { font-family: var(--font-display); font-size: 1.1rem; color: var(--nc-cream); }
    .card-del { background: transparent; border: none; color: var(--nc-dim); cursor: pointer; font-size: 1.2rem; }
    .card-del:hover { color: var(--nc-red); }
    .card-role { font-size: 0.75rem; color: var(--nc-red); font-weight: bold; margin-bottom: 0.5rem; letter-spacing: 0.1em; }
    .card-stats { font-size: 0.8rem; color: var(--nc-dim); display: flex; gap: 0.8rem; }
    .card-owner { font-size: 0.6rem; color: var(--nc-dim); letter-spacing: 0.08em; margin-top: 2px; display: block; }
    .card-footer { margin-top: 1rem; padding-top: 0.8rem; border-top: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-between; font-size: 0.65rem; color: var(--nc-dim); }

    /* WIZARD */
    .wizard-container { background: var(--nc-panel); border: 1px solid var(--nc-border); border-top: 4px solid var(--nc-red); }
    .wizard-header { padding: 1.5rem; border-bottom: 1px solid var(--nc-border); display: flex; align-items: center; gap: 2rem; }
    .wiz-back-btn { background: var(--nc-dark); border: 1px solid var(--nc-border); color: var(--nc-red); padding: 0.4rem 1rem; cursor: pointer; font-family: var(--font-mono); font-size: 0.8rem; }
    .wiz-stepper { flex: 1; display: flex; justify-content: space-around; }
    .wiz-step { display: flex; flex-direction: column; align-items: center; opacity: 0.3; }
    .wiz-step.active { opacity: 1; color: var(--nc-red); }
    .wiz-step.done { opacity: 0.8; color: var(--nc-green); }
    .step-num { font-size: 1.2rem; font-weight: bold; margin-bottom: 0.2rem; }
    .step-label { font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; }

    .wizard-content { padding: 2rem; max-width: 900px; margin: 0 auto; min-height: 500px; }
    .wiz-section h3 { color: var(--nc-red); margin-bottom: 1.5rem; letter-spacing: 0.1em; border-bottom: 1px solid var(--nc-red); padding-bottom: 0.5rem; }
    .wiz-field { margin-bottom: 1.5rem; }
    .wiz-field label { display: block; font-size: 0.75rem; color: var(--nc-dim); margin-bottom: 0.5rem; }

    .role-selector { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; }
    .role-card { background: var(--nc-dark); border: 1px solid var(--nc-border); padding: 1rem; cursor: pointer; }
    .role-card.selected { border-color: var(--nc-red); background: rgba(255,0,60,0.05); }
    .role-name { font-weight: bold; margin-bottom: 0.4rem; color: var(--nc-cream); }
    .role-special { font-size: 0.7rem; color: var(--nc-dim); }

    .pool-header { display: flex; justify-content: space-between; align-items: center; background: var(--nc-dark); padding: 1rem; margin-bottom: 1.5rem; border: 1px solid var(--nc-border); }
    .pool-header strong.ok { color: var(--nc-green); }
    .pool-header strong.over { color: var(--nc-red); animation: blink 1s infinite; }
    .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 3rem; }
    .stat-row { display: flex; justify-content: space-between; align-items: center; }
    .stat-info { display: flex; flex-direction: column; }
    .stat-name { font-weight: bold; color: var(--nc-cream); }
    .stat-desc { font-size: 0.65rem; color: var(--nc-dim); }
    .stat-input { width: 60px; background: var(--nc-dark); border: 1px solid var(--nc-border); color: var(--nc-red); padding: 0.4rem; text-align: center; }

    .lifepath-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 2rem; }
    .pool-bar { background: var(--nc-dark); padding: 0.5rem 1rem; font-size: 0.8rem; border-left: 3px solid var(--nc-cyan); margin-bottom: 1rem; }
    .skills-scroll { max-height: 300px; overflow-y: auto; border: 1px solid var(--nc-border); padding: 1rem; background: rgba(0,0,0,0.2); margin-bottom: 1rem; }
    .skill-row { display: flex; justify-content: space-between; align-items: center; padding: 0.4rem 0; border-bottom: 1px solid rgba(255,255,255,0.03); }
    .skill-name.special { color: var(--nc-gold); font-weight: bold; }
    .skill-ctrl { display: flex; align-items: center; gap: 0.8rem; }
    .skill-ctrl button { background: var(--nc-dark); border: 1px solid var(--nc-border); color: var(--nc-cream); width: 24px; height: 24px; cursor: pointer; }
    .skill-val { min-width: 20px; text-align: center; font-weight: bold; color: var(--nc-red); }

    .wizard-footer { padding: 1.5rem; border-top: 1px solid var(--nc-border); display: flex; justify-content: flex-end; align-items: center; gap: 2rem; }
    .wiz-btn { background: transparent; border: 1px solid var(--nc-border); color: var(--nc-cream); padding: 0.6rem 2rem; cursor: pointer; font-family: var(--font-mono); }
    .wiz-btn.primary { background: var(--nc-red); border-color: var(--nc-red); color: var(--nc-black); font-weight: bold; }
    .wiz-btn.primary:disabled { opacity: 0.4; cursor: not-allowed; }

</style>

@code {
    private List<CharacterSheet> _characters = new();
    private Dictionary<string, string> _userMap = new();
    
    private string _rosterFilter = "All";
    private string RosterFilter 
    { 
        get => _rosterFilter; 
        set { _rosterFilter = value; StateHasChanged(); } 
    }
    
    private List<CharacterSheet> FilteredCharacters => _rosterFilter switch {
        "Players" => _characters.Where(c => !c.IsTestAsset).ToList(),
        "Tests" => _characters.Where(c => c.IsTestAsset).ToList(),
        _ => _characters
    };
    private bool _loading = true;
    private bool _isCreating = false;
    
    // Wizard State
    private int _stage = 0;
    private string[] _stageLabels = ["IDENTITY", "ROLE", "STATS", "LIFEPATH", "SKILLS"];
    
    // Character Fields
    private string _handle = "";
    private string _name = "";
    private string _origin = "";
    private string _role = "";
    private string _specialAbility = "";
    private bool _isElite = false;
    private Dictionary<string, int> _stats = new() { ["INT"]=5, ["REF"]=5, ["TECH"]=5, ["COOL"]=5, ["LK"]=5, ["ATT"]=5, ["MA"]=5, ["EMP"]=5, ["BT"]=5 };
    private string _clothes = "";
    private string _hairstyle = "";
    private string _affectation = "";
    private string _familyRanking = "";
    private string _familyTragedy = "";
    private string _personality = "";
    private Dictionary<string, int> _careerSkills = new();
    private Dictionary<string, int> _pickupSkills = new();

    private bool _saving = false;
    private string _error = "";

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();

        if (Session.CurrentUser?.Role == UserRole.GameMaster)
            _userMap = (await UserApi.GetAllAsync()).ToDictionary(u => u.Id, u => u.Nickname);

        await LoadCharacters();
    }

    private async Task LoadCharacters()
    {
        _loading = true;
        try
        {
            var ownerId = Session.CurrentUser?.Role == UserRole.Player
                ? Session.CurrentUser.Id
                : null;
            _characters = await CharApi.GetAllAsync(ownerId);
        }
        catch { _characters = new(); }
        _loading = false;
    }

    private void StartCreation()
    {
        ResetForm();
        _isCreating = true;
    }

    private void CancelCreation() => _isCreating = false;

    private void ResetForm()
    {
        _stage = 0;
        _handle = _name = _origin = _role = _specialAbility = _clothes = _hairstyle = _affectation = _familyRanking = _familyTragedy = _personality = "";
        _isElite = false;
        foreach (var k in _stats.Keys.ToList()) _stats[k] = 5;
        _careerSkills.Clear();
        _pickupSkills.Clear();
    }

    private int PointPool => _isElite ? 80 : 75;
    private int PointsRemaining => PointPool - _stats.Values.Sum();
    private int PickupPool => _stats["INT"] + _stats["REF"];
    private int CareerPointsRemaining => 40 - _careerSkills.Values.Sum();
    private int PickupPointsRemaining => PickupPool - _pickupSkills.Values.Sum();

    private void AdjStat(string key, int delta)
    {
        int cur = _stats[key];
        _stats[key] = Math.Clamp(cur + delta, 2, 10);
    }

    private void SetStat(string key, string? raw)
    {
        if (int.TryParse(raw, out var v)) _stats[key] = Math.Clamp(v, 2, 10);
    }

    private void SelectRole(RoleDef r)
    {
        _role = r.Name;
        _specialAbility = r.Special;
        _careerSkills.Clear();
        foreach (var s in r.CareerSkills) _careerSkills[s] = 0;
    }

    private void AdjSkill(Dictionary<string, int> dict, string key, int delta)
    {
        dict.TryGetValue(key, out var cur);
        dict[key] = Math.Max(0, Math.Min(10, cur + delta));
    }

    private bool CanAdvance => _stage switch
    {
        0 => !string.IsNullOrWhiteSpace(_handle) && !string.IsNullOrEmpty(_origin),
        1 => !string.IsNullOrEmpty(_role),
        2 => PointsRemaining == 0,
        3 => !string.IsNullOrEmpty(_clothes) && !string.IsNullOrEmpty(_familyRanking),
        _ => true
    };

    private void NextStage() { if (CanAdvance) _stage++; }
    private void PrevStage() { if (_stage > 0) _stage--; }

    private async Task SaveCharacter()
    {
        _error = "";
        _saving = true;
        try
        {
            var allSkills = new Dictionary<string, int>(_careerSkills);
            foreach (var kv in _pickupSkills) allSkills[kv.Key] = allSkills.GetValueOrDefault(kv.Key) + kv.Value;

            int saLevel = _careerSkills.GetValueOrDefault(_specialAbility, 0);
            if (saLevel < 1) saLevel = 1;

            var sheet = new CharacterSheet
            {
                OwnerId = Session.CurrentUser?.Id ?? string.Empty,
                Handle = _handle.Trim(), Name = _name.Trim(),
                EthnicOrigin = _origin, Role = _role, SpecialAbility = _specialAbility,
                INT = _stats["INT"], REF = _stats["REF"], TECH = _stats["TECH"],
                COOL = _stats["COOL"], LK = _stats["LK"], ATT = _stats["ATT"],
                MA = _stats["MA"], EMP = _stats["EMP"], BT = _stats["BT"],
                IsElite = _isElite,
                Clothes = _clothes, Hairstyle = _hairstyle, Affectation = _affectation,
                FamilyRanking = _familyRanking, FamilyTragedy = _familyTragedy,
                PersonalityTrait = _personality,
                SkillsJson = JsonSerializer.Serialize(allSkills),
                Humanity = _stats["EMP"] * 10,
                Mobility = _stats["MA"] * 3,
                Resilience = _stats["BT"] switch { <= 4 => 0, <= 7 => 1, <= 9 => 2, _ => 3 },
                Eurobucks = CalculateStartingFunds(_role, saLevel),
                CreatedAt = DateTime.UtcNow
            };

            var result = await CharApi.CreateAsync(sheet);
            if (result is not null)
            {
                _isCreating = false;
                await LoadCharacters();
            }
            else { _error = "DATABASE CONNECTION FAILURE."; }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task DeleteCharacter(string id)
    {
        await CharApi.DeleteAsync(id);
        await LoadCharacters();
    }

    private void ShowDetail(CharacterSheet c) => Nav.NavigateTo($"/characters/{c.Id}", forceLoad: true);
    
    private int CalculateStartingFunds(string role, int level)
    {
        int[] g1 = {1000, 1000, 1500, 2000, 3000, 4000, 5000, 7000, 9000, 12000};
        int[] g2 = {1000, 1000, 1200, 1500, 2000, 2500, 3000, 4000, 5000, 7000};
        int[] g3 = {1500, 1500, 2000, 2500, 3000, 4000, 5000, 7000, 9000, 12000};
        int[] g4 = {1000, 1000, 1500, 2000, 2500, 3000, 4000, 5000, 7000, 9000};

        int[] table = role switch {
            "Rockerboy" or "Solo" or "Cop" or "Media" or "Fixer" => g1,
            "Techie" or "Medtech" or "Netrunner" => g2,
            "Corporate" => g3,
            "Nomad" => g4,
            _ => g1
        };
        int index = Math.Clamp(level, 1, 10) - 1;
        return table[index];
    }

