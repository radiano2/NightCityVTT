    // ── Lifecycle ─────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        _isGm = Session.CurrentUser?.Role == UserRole.GameMaster;

        _map = await MapApi.GetByIdAsync(MapId);
        if (_map is null) { _loading = false; return; }

        _characters = await CharApi.GetAllAsync();
        _charById   = _characters.Where(c => c.Id != null).ToDictionary(c => c.Id!);

        await ConnectHub();
        _loading = false;
        // Explicitly notify Blazor so OnAfterRenderAsync fires with the canvas in the DOM.
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Guard: canvas element only exists in the DOM when _loading=false and _map!=null.
        // _map can be set while _loading is still true (between GetByIdAsync and ConnectHub),
        // so we must check both — otherwise init() is called before the canvas element is rendered.
        if (_canvasInitialized || _loading || _map is null) return;

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/map-engine.js?v=2");
        _dotNetRef ??= DotNetObjectReference.Create(this);

        var ok = await _module.InvokeAsync<bool>("init", "battle-map-canvas",
            _map.Width, _map.Height, _map.TileSize);
        if (!ok)
        {
            // Canvas not yet in DOM (layout not committed). Retry on the next frame.
            await Task.Delay(50);
            StateHasChanged();
            return;
        }
        _canvasInitialized = true;
        await _module.InvokeVoidAsync("setDotnetRef", _dotNetRef);
        await _module.InvokeVoidAsync("loadMap", _map);
    }

    // ── SignalR ────────────────────────────────────────────────────────────

    private async Task ConnectHub()
    {
        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/game"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<string, int, int>("TokenMoved", async (tokenId, col, row) =>
        {
            var t = _map?.Tokens.Find(x => x.Id == tokenId);
            if (t != null) { t.Col = col; t.Row = row; }
            if (_module != null)
                await _module.InvokeVoidAsync("updateToken", new { id = tokenId, col, row });
            await InvokeAsync(StateHasChanged);
        });

        _hub.On<List<TileCell>>("MapTilesUpdated", async (tiles) =>
        {
            if (_map != null)
            {
                _map.Tiles = tiles;
                if (_module != null) await _module.InvokeVoidAsync("loadMap", _map);
            }
        });

        _hub.On<TokenState>("TokenAdded", async (token) =>
        {
            _map?.Tokens.Add(token);
            if (_module != null) await _module.InvokeVoidAsync("updateToken", token);
            await InvokeAsync(StateHasChanged);
        });

        _hub.On<string>("TokenRemoved", async (tokenId) =>
        {
            _map?.Tokens.RemoveAll(t => t.Id == tokenId);
            if (_module != null) await _module.InvokeVoidAsync("removeToken", tokenId);
            if (_selectedToken?.Id == tokenId) _selectedToken = null;
            await InvokeAsync(StateHasChanged);
        });

        _hub.On<string, int>("TokenCombatUpdated", async (tokenId, totalDmg) =>
        {
            var t = _map?.Tokens.Find(x => x.Id == tokenId);
            if (t != null) t.TotalDamageTaken = totalDmg;
            await InvokeAsync(StateHasChanged);
        });

        _hub.On<CombatLogEntry>("CombatLogAppended", async (entry) =>
        {
            _map?.CombatLog.Add(entry);
            await InvokeAsync(StateHasChanged);
        });

        _hub.On<List<TeamDto>>("MapTeamsUpdated", async (teams) =>
        {
            if (_map != null) _map.Teams = teams;
            await InvokeAsync(StateHasChanged);
        });

        _hub.Reconnected   += _ => { _hubStatus = "connected"; return InvokeAsync(StateHasChanged); };
        _hub.Reconnecting  += _ => { _hubStatus = "reconnecting"; return InvokeAsync(StateHasChanged); };
        _hub.Closed        += _ => { _hubStatus = "offline"; return InvokeAsync(StateHasChanged); };

        await _hub.StartAsync();
        _hubStatus = "connected";
        await _hub.SendAsync("JoinMap", MapId);
    }

