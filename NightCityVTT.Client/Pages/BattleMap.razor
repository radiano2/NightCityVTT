    private async Task ClearCombatWeapon()
    {
        _selectedWeapon  = null;
        _weaponStats     = null;
        _weaponSkillName = "";
        if (_module != null) await _module.InvokeVoidAsync("clearAttackRange");
    }

    private async Task OnCombatWeaponChanged(ChangeEventArgs e)
    {
        var instanceId = e.Value?.ToString() ?? "";
        if (string.IsNullOrEmpty(instanceId)) { await ClearCombatWeapon(); return; }

        if (_selectedToken == null || !_charById.TryGetValue(_selectedToken.CharacterId, out var c)) return;
        _selectedWeapon  = c.Inventory.FirstOrDefault(i => i.InstanceId == instanceId);
        if (_selectedWeapon == null) return;

        _weaponStats     = ParseWeaponStats(_selectedWeapon);
        _weaponSkillName = GetWeaponSkillName(_weaponStats);

        if (_map != null && _module != null)
        {
            var cells = GetCellsInRange(_selectedToken.Col, _selectedToken.Row, _weaponStats.BaseRange);
            await _module.InvokeVoidAsync("setAttackRange",
                cells.Select(cell => new { col = cell.col, row = cell.row }).ToList());
        }
    }

    private static WeaponStats ParseWeaponStats(GearItemDto w)
    {
        int wa = 0;
        int.TryParse(w.Acc.Replace("+", "").Trim(), out wa);

        int baseRange = 50;
        if (w.Range == "Melee") baseRange = 1;
        else if (w.Range.EndsWith("m") && int.TryParse(w.Range.Replace("m", "").Trim(), out int r)) baseRange = r;

        return new WeaponStats { WA = wa, DamageDice = w.Damage, BaseRange = Math.Max(1, baseRange) };
    }

    private static string GetWeaponSkillName(WeaponStats stats) => stats.BaseRange switch
    {
        <= 4   => "Melee",
        <= 80  => "Handgun",
        <= 200 => "Submachine Gun",
        _      => "Rifle"
    };

    private List<(int col, int row)> GetCellsInRange(int startCol, int startRow, int range)
    {
        if (_map is null) return new();
        var result = new List<(int, int)>();
        for (int r = 0; r < _map.Height; r++)
        for (int c = 0; c < _map.Width;  c++)
        {
            if (c == startCol && r == startRow) continue;
            double dist = Math.Sqrt((c - startCol) * (c - startCol) + (r - startRow) * (r - startRow));
            if (dist <= range) result.Add((c, r));
        }
        return result;
    }

    private static int GetDistance(TokenState a, TokenState b)
    {
        int dx = a.Col - b.Col, dy = a.Row - b.Row;
        return (int)Math.Round(Math.Sqrt(dx * dx + dy * dy));
    }

    private List<TokenState> GetTargetsInRange()
    {
        if (_selectedToken == null || _weaponStats == null || _map == null) return new();
        bool useTeams = _map.Teams.Count > 0 && !string.IsNullOrEmpty(_selectedToken.TeamId);
        return _map.Tokens
            .Where(t => t.Id != _selectedToken.Id
                   && GetDistance(_selectedToken, t) <= _weaponStats.BaseRange
                   && (!useTeams || IsOpposingTeam(_selectedToken.TeamId, t.TeamId)))
            .ToList();
    }

    private bool IsOpposingTeam(string attackerTeamId, string targetTeamId)
    {
        if (string.IsNullOrEmpty(attackerTeamId) || string.IsNullOrEmpty(targetTeamId)) return true;
        var atk = _map?.Teams.Find(t => t.Id == attackerTeamId);
        var tgt = _map?.Teams.Find(t => t.Id == targetTeamId);
        if (atk is null || tgt is null) return true;
        return atk.IsPlayerSide != tgt.IsPlayerSide;
    }

    private CharacterCombatState BuildCombatState(CharacterSheet c, int totalDamageTaken)
    {
        var skills = new Dictionary<string, int>();
        if (!string.IsNullOrEmpty(c.SkillsJson))
            try { skills = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, int>>(c.SkillsJson) ?? new(); }
            catch { }

        int evPenalty = GetTotalEV(c);

        var state = new CharacterCombatState
        {
            REF  = Math.Max(1, c.REF - evPenalty),
            BODY = c.BT,
            COOL = c.COOL,
            Skills = skills,
            TotalDamageTaken = totalDamageTaken
        };

        state.ArmorSP[HitLocation.Head]     = GetEquippedSP(c, "HEAD");
        state.ArmorSP[HitLocation.Torso]    = GetEquippedSP(c, "TORSO");
        state.ArmorSP[HitLocation.RightArm] = GetEquippedSP(c, "R.ARM");
        state.ArmorSP[HitLocation.LeftArm]  = GetEquippedSP(c, "L.ARM");
        state.ArmorSP[HitLocation.RightLeg] = GetEquippedSP(c, "R.LEG");
        state.ArmorSP[HitLocation.LeftLeg]  = GetEquippedSP(c, "L.LEG");

        return state;
    }

    private static int GetEquippedSP(CharacterSheet c, string slot)
    {
        var layers = new List<int>();

        if (c.EquippedGearIds.TryGetValue(slot, out var innerId))
        {
            var item = c.Inventory.FirstOrDefault(i => i.InstanceId == innerId);
            if (item != null && int.TryParse(item.SP, out int sp)) layers.Add(sp);
        }

        if (c.EquippedGearIds.TryGetValue(slot + "_OUTER", out var outerId))
        {
            var item = c.Inventory.FirstOrDefault(i => i.InstanceId == outerId);
            if (item != null && int.TryParse(item.SP, out int sp)) layers.Add(sp);
        }

        foreach (var cyberId in c.InstalledCyberwareIds)
        {
            var cyber = c.Inventory.FirstOrDefault(i => i.InstanceId == cyberId);
            if (cyber != null && cyber.Name.Contains("Skinweave", StringComparison.OrdinalIgnoreCase))
            {
                if (int.TryParse(cyber.SP, out int sp)) layers.Add(sp);
                else layers.Add(12);
            }
        }

        if (layers.Count == 0) return 0;
        
        layers.Sort((a, b) => b.CompareTo(a)); // Descending order
        int total = layers[0];
        for (int i = 1; i < layers.Count; i++)
        {
            total += layers[i] / 2;
        }

        return total;
    }

    private static int GetTotalEV(CharacterSheet c)
    {
        int totalEV = 0;
        foreach (var id in c.EquippedGearIds.Values.Distinct())
        {
            var item = c.Inventory.FirstOrDefault(i => i.InstanceId == id);
            if (item != null && int.TryParse(item.EV, out int ev))
            {
                totalEV += ev;
            }
        }
        return totalEV;
    }

    private static WoundState WoundStateFromDmg(int dmg) => dmg switch
    {
        0    => WoundState.Uninjured,
        <= 4  => WoundState.Light,
        <= 8  => WoundState.Serious,
        <= 12 => WoundState.Critical,
        <= 16 => WoundState.Mortal0,
        <= 20 => WoundState.Mortal1,
        <= 24 => WoundState.Mortal2,
        <= 28 => WoundState.Mortal3,
        <= 32 => WoundState.Mortal4,
        <= 36 => WoundState.Mortal5,
        <= 40 => WoundState.Mortal6,
        _    => WoundState.Dead
    };

    private static string GetWoundClass(WoundState ws) => ws switch
    {
        WoundState.Uninjured => "bm-ws-ok",
        WoundState.Light     => "bm-ws-light",
        WoundState.Serious   => "bm-ws-serious",
        WoundState.Critical  => "bm-ws-critical",
        WoundState.Dead      => "bm-ws-dead",
        _                    => "bm-ws-mortal"
    };

    private async Task ExecuteSuppressiveFire(TokenState target)
    {
        if (_selectedToken == null || _selectedWeapon == null || _weaponStats == null) return;
        if (!_charById.TryGetValue(_selectedToken.CharacterId, out var attackerChar)) return;
        if (!_charById.TryGetValue(target.CharacterId, out var targetChar)) return;

        _combatLog.Add(("───", ""));
        _combatLog.Add(($"<span style='color:var(--nc-red)'>{_selectedToken.Handle.ToUpper()}</span> lays down SUPPRESSIVE FIRE on <span style='color:{target.Color}'>{target.Handle.ToUpper()}</span>!", ""));

        int targetNumber = 15; // Base COOL check DN
        if (_modAuto)
        {
            targetNumber = Math.Max(10, _autoRounds / 2);
            _combatLog.Add(($"<span style='color:var(--nc-cyan)'>[AUTO]</span> {_autoRounds} rounds fired. Target Number: {targetNumber}", ""));
        }
        else if (_modBurst)
        {
            targetNumber = 10;
        }

        int roll = new Random().Next(1, 11);
        int total = roll + targetChar.COOL;
        bool pass = total >= targetNumber;

        if (pass)
        {
             _combatLog.Add(($"<span style='color:var(--nc-green)'>[PASSED]</span> {target.Handle.ToUpper()} rolled {roll} + COOL {targetChar.COOL} = {total} (vs {targetNumber}).", ""));
        }
        else
        {
             _combatLog.Add(($"<span class='bm-log-fumble'>[SUPPRESSED]</span> {target.Handle.ToUpper()} rolled {roll} + COOL {targetChar.COOL} = {total} (vs {targetNumber}). They must take cover!", "bm-log-fumble"));
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ExecuteAttack(TokenState target)
    {
        if (_selectedToken == null || _selectedWeapon == null || _weaponStats == null) return;
        if (!_charById.TryGetValue(_selectedToken.CharacterId, out var attackerChar)) return;
        if (!_charById.TryGetValue(target.CharacterId, out var targetChar)) return;

        var attackerState = BuildCombatState(attackerChar, _selectedToken.TotalDamageTaken);
        var targetState   = BuildCombatState(targetChar,   target.TotalDamageTaken);
        int distance      = GetDistance(_selectedToken, target);

        _combatLog.Add(("───", ""));
        _combatLog.Add(($"<span style='color:var(--nc-red)'>{_selectedToken.Handle.ToUpper()}</span> → <span style='color:{target.Color}'>{target.Handle.ToUpper()}</span> | {_selectedWeapon.Name} | {distance}m", ""));

        int modifiers = 0;
        if (_modAim) modifiers += 3;
        if (_modBurst) modifiers += 3;
        if (_modAuto)
        {
            int autoMod = _autoRounds / 10;
            if (distance <= _weaponStats.BaseRange / 4) modifiers += autoMod;
            else if (distance > _weaponStats.BaseRange / 2) modifiers -= autoMod;
        }
        if (_modOneHanded) modifiers -= 3;
        if (_modCover > 0) modifiers -= _modCover;
        if (!string.IsNullOrEmpty(_modCalledShot)) modifiers -= 4;

        if (_modLuck > 0 && attackerChar.CurrentLuck >= _modLuck)
        {
            modifiers += _modLuck;
            attackerChar.CurrentLuck -= _modLuck;
            await CharApi.UpdateAsync(attackerChar);
            _modLuck = 0; // Reset so they don't accidentally spend it again
        }

        var hit = _fnff.RollToHit(attackerState, _weaponStats, _weaponSkillName, distance, modifiers);

        string rangeLabel = distance <= 1 ? "PB/10" : distance <= _weaponStats.BaseRange / 4 ? "Close/15" :
                            distance <= _weaponStats.BaseRange / 2 ? "Med/20" :
                            distance <= _weaponStats.BaseRange ? "Long/25" : "Extreme/30";
        string wpTag = attackerState.WoundPenalty < 0 ? $" Wound({attackerState.WoundPenalty})" : "";
        string modTag = modifiers != 0 ? $" Mod({(modifiers > 0 ? "+" : "")}{modifiers})" : "";

        var logEntry = new CombatLogEntry
        {
            AttackerHandle = _selectedToken.Handle,
            TargetHandle   = target.Handle,
            WeaponName     = _selectedWeapon.Name,
            Roll           = hit.TotalRoll,
            TargetDN       = hit.TargetNumber,
            IsHit          = hit.IsHit,
            IsCritical     = hit.IsCritical,
            IsFumble       = hit.IsFumble
        };

        if (hit.IsFumble)
        {
            _combatLog.Add(("<span class='bm-log-fumble'>[FUMBLE]</span> Weapon jams / drops.", "bm-log-fumble"));
        }
        else
        {
            string critTag = hit.IsCritical ? " <span class='bm-log-crit'>[CRIT]</span>" : "";
            string hitTag  = hit.IsHit
                ? "<span class='bm-log-hit'>[HIT]</span>"
                : "<span class='bm-log-miss'>[MISS]</span>";
            _combatLog.Add(($"Roll {hit.TotalRoll}{critTag}{wpTag}{modTag} vs DN {hit.TargetNumber} ({rangeLabel}) → {hitTag}", ""));
        }

        if (hit.IsHit)
        {
            int numHits = 1;
            if (_modAuto)
            {
                numHits = Math.Clamp(hit.TotalRoll - hit.TargetNumber, 1, _autoRounds);
                _combatLog.Add(($"<span style='color:var(--nc-cyan)'>[FULL AUTO]</span> Fired {_autoRounds} rounds, {numHits} hit the target!", ""));
            }
            else if (_modBurst)
            {
                numHits = (new Random().Next(1, 7) + 1) / 2;
                _combatLog.Add(($"<span style='color:var(--nc-cyan)'>[BURST FIRE]</span> {numHits} rounds hit the target!", ""));
            }

            for (int i = 0; i < numHits; i++)
            {
                if (target.TotalDamageTaken >= 40 && i > 0) break; // Don't keep shooting if already fully dead

                var hitLogEntry = new CombatLogEntry
                {
                    AttackerHandle = _selectedToken.Handle,
                    TargetHandle   = target.Handle,
                    WeaponName     = _selectedWeapon.Name + (numHits > 1 ? $" (Hit {i+1})" : ""),
                    IsHit          = true,
                    IsCritical     = hit.IsCritical,
                    IsFumble       = false,
                    Timestamp      = DateTime.UtcNow
                };

                var location = string.IsNullOrEmpty(_modCalledShot) 
                    ? _fnff.RollHitLocation() 
                    : Enum.Parse<HitLocation>(_modCalledShot);
                var dmg      = _fnff.CalculateDamage(targetState, _weaponStats.DamageDice, location);
                target.TotalDamageTaken = targetState.TotalDamageTaken;

                int sp = targetState.ArmorSP.GetValueOrDefault(location, 0);
                _combatLog.Add(($"Loc: <strong>{location}</strong> | DMG {dmg.RawDamage} − SP{sp} − BTM{targetState.BTM} = <strong>{dmg.FinalDamageApplied}</strong>", ""));

                if (_module != null)
                {
                    await _module.InvokeVoidAsync("triggerAttackEffect", _selectedToken.Id, target.Id, $"-{dmg.FinalDamageApplied}", true);
                }

                var ws = WoundStateFromDmg(target.TotalDamageTaken);
                _combatLog.Add(($"<span class='{GetWoundClass(ws)}'>{target.Handle.ToUpper()}: {ws.ToString().ToUpper()}</span> (total {target.TotalDamageTaken})", GetWoundClass(ws)));

                bool? stunSaved = null, deathSaved = null;
                if (dmg.RequiresStunSave)
                {
                    bool stunOk = _fnff.MakeStunSave(targetState);
                    stunSaved = stunOk;
                    _combatLog.Add(stunOk
                        ? ("<span class='bm-log-hit'>Stun save PASSED</span>", "")
                        : ("<span class='bm-log-fumble'>Stun save FAILED — stunned 1 turn</span>", "bm-log-fumble"));
                }
                if (dmg.RequiresDeathSave)
                {
                    bool deathOk = _fnff.MakeDeathSave(targetState);
                    deathSaved = deathOk;
                    _combatLog.Add(deathOk
                        ? ("<span class='bm-log-hit'>Death save PASSED</span>", "")
                        : ("<span class='bm-log-fumble'>Death save FAILED — DEAD</span>", "bm-log-fumble"));
                }

                hitLogEntry.Location        = location.ToString();
                hitLogEntry.RawDamage       = dmg.RawDamage;
                hitLogEntry.FinalDamage     = dmg.FinalDamageApplied;
                hitLogEntry.WoundState      = ws.ToString();
                hitLogEntry.StunSavePassed  = stunSaved;
                hitLogEntry.DeathSavePassed = deathSaved;

                if (dmg.PenetratingDamage > 0)
                {
                    string slotName = location switch
                    {
                        HitLocation.Head => "HEAD",
                        HitLocation.Torso => "TORSO",
                        HitLocation.RightArm => "R.ARM",
                        HitLocation.LeftArm => "L.ARM",
                        HitLocation.RightLeg => "R.LEG",
                        HitLocation.LeftLeg => "L.LEG",
                        _ => ""
                    };
                    if (targetChar.EquippedGearIds.TryGetValue(slotName, out var id))
                    {
                        var item = targetChar.Inventory.FirstOrDefault(i => i.InstanceId == id);
                        if (item != null && int.TryParse(item.SP, out int currentSp) && currentSp > 0)
                        {
                            item.SP = (currentSp - 1).ToString();
                            _combatLog.Add(($"<span style='color:#ff8c00'>Armor degraded at {location}: SP now {item.SP}</span>", ""));
                            await CharApi.UpdateAsync(targetChar);
                        }
                    }
                }

                // Sync wound state to server + other clients
                if (_map != null)
                {
                    _map.CombatLog.Add(hitLogEntry);
                    await MapApi.UpdateAsync(_map);
                }
                if (_hub?.State == HubConnectionState.Connected)
                {
                    await _hub.SendAsync("UpdateTokenCombat", MapId, target.Id, target.TotalDamageTaken);
                    await _hub.SendAsync("AppendCombatLog", MapId, hitLogEntry);
                }
            }
        }
        else
        {
            if (_map != null) _map.CombatLog.Add(logEntry);
            if (_hub?.State == HubConnectionState.Connected)
                await _hub.SendAsync("AppendCombatLog", MapId, logEntry);

            if (_module != null)
            {
                await _module.InvokeVoidAsync("triggerAttackEffect", _selectedToken.Id, target.Id, "MISS", false);
            }
        }

        if (_combatLog.Count > 40) _combatLog.RemoveRange(0, _combatLog.Count - 40);
        StateHasChanged();
    }

    // ── Team management ───────────────────────────────────────────────────

    private async Task AddTeam()
    {
        if (string.IsNullOrEmpty(_newTeamName) || _map is null) return;
        _map.Teams.Add(new TeamDto
        {
            Name = _newTeamName, Color = _newTeamColor, IsPlayerSide = _newTeamIsPlayer
        });
        _newTeamName = "";
        await MapApi.UpdateAsync(_map);
        if (_hub?.State == HubConnectionState.Connected)
            await _hub.SendAsync("UpdateMapTeams", MapId, _map.Teams);
    }

    private async Task RemoveTeam(string teamId)
    {
        if (_map is null) return;
        _map.Teams.RemoveAll(t => t.Id == teamId);
        foreach (var tok in _map.Tokens.Where(t => t.TeamId == teamId))
            tok.TeamId = "";
        await MapApi.UpdateAsync(_map);
        if (_hub?.State == HubConnectionState.Connected)
            await _hub.SendAsync("UpdateMapTeams", MapId, _map.Teams);
    }

    // ── Loot ──────────────────────────────────────────────────────────────

    private IEnumerable<(TokenState Token, CharacterSheet Sheet)> GetDeadTokens()
        => _map?.Tokens
               .Where(t => WoundStateFromDmg(t.TotalDamageTaken) == WoundState.Dead)
               .Select(t => (Token: t, Sheet: _charById.GetValueOrDefault(t.CharacterId)!))
               .Where(x => x.Sheet != null)
           ?? Enumerable.Empty<(TokenState, CharacterSheet)>();

    private void OpenLoot()
    {
        _lootOpen = true;
        _takingEb.Clear();
        _lootRecipientId = _characters
            .FirstOrDefault(c => c.OwnerId == Session.CurrentUser?.Id)?.Id ?? "";
    }

    private async Task TakeItem(CharacterSheet donor, GearItemDto item)
    {
        if (string.IsNullOrEmpty(_lootRecipientId) || donor.Id is null) return;
        bool ok = await ScenarioApi.TransferItemAsync(donor.Id, item.InstanceId, _lootRecipientId);
        if (!ok) return;
        donor.Inventory.RemoveAll(i => i.InstanceId == item.InstanceId);
        var recipient = _charById.GetValueOrDefault(_lootRecipientId);
        if (recipient != null)
            recipient.Inventory.Add(new GearItemDto
            {
                Name = item.Name, Category = item.Category, Damage = item.Damage,
                Acc = item.Acc, Range = item.Range, SP = item.SP,
                CostEurobucks = item.CostEurobucks,
                HumanityCostDice = item.HumanityCostDice, Description = item.Description,
                InstanceId = Guid.NewGuid().ToString("N")[..8]
            });
        StateHasChanged();
    }

    private void SetTakingEb(string? charId, string? val)
    {
        if (charId is null) return;
        if (int.TryParse(val, out int v)) _takingEb[charId] = v;
    }

    private async Task TakeEb(CharacterSheet donor)
    {
        int amount = _takingEb.GetValueOrDefault(donor.Id ?? "", 0);
        if (amount <= 0 || string.IsNullOrEmpty(_lootRecipientId) || donor.Id is null) return;
        await ScenarioApi.TransferItemAsync(donor.Id, "", _lootRecipientId, amount);
        int actual = Math.Min(amount, donor.Eurobucks);
        donor.Eurobucks -= actual;
        var recipient = _charById.GetValueOrDefault(_lootRecipientId);
        if (recipient != null) recipient.Eurobucks += actual;
        _takingEb[donor.Id] = 0;
        StateHasChanged();
    }

    // ── Log panel ─────────────────────────────────────────────────────────

    private IEnumerable<CombatLogEntry> GetFilteredLog()
    {
        if (_map is null) return Enumerable.Empty<CombatLogEntry>();
        var src = _map.CombatLog.AsEnumerable().Reverse();
        return _logFilter switch
        {
            "HITS"   => src.Where(e => e.IsHit && !e.IsFumble),
            "MISSES" => src.Where(e => !e.IsHit && !e.IsFumble),
            "CRITS"  => src.Where(e => e.IsCritical),
            _        => src
        };
    }

    private async Task ClearCombatLog()
    {
        if (_map is null) return;
        _map.CombatLog.Clear();
        await MapApi.UpdateAsync(_map);
    }

    // ── Dispose ───────────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        if (_hub?.State == HubConnectionState.Connected)
            await _hub.SendAsync("LeaveMap", MapId);
        if (_hub != null) await _hub.DisposeAsync();
        if (_module != null) await _module.DisposeAsync();
        _dotNetRef?.Dispose();
    }
}

