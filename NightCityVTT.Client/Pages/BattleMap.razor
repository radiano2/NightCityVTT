    private async Task AddToken()
    {
        if (string.IsNullOrEmpty(_addCharId) || _map is null) return;
        var c = _characters.FirstOrDefault(x => x.Id == _addCharId);
        if (c is null) return;
        var color = TokenPalette[_map.Tokens.Count % TokenPalette.Length];
        var token = new TokenState {
            Id          = Guid.NewGuid().ToString("N")[..8],
            CharacterId = c.Id ?? "",
            Handle      = c.Handle,
            Col = 1, Row = 1,
            Color       = color,
            TeamId      = _addTokenTeamId,
            MoveRange   = c.MA * 2
        };
        _map.Tokens.Add(token);
        _addCharId      = "";
        _addTokenTeamId = "";
        if (_module != null) await _module.InvokeVoidAsync("updateToken", token);
        await MapApi.UpdateAsync(_map);
        if (_hub?.State == HubConnectionState.Connected)
            await _hub.SendAsync("AddToken", MapId, token);
