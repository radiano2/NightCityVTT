    // ── BFS movement range ────────────────────────────────────────────────

    private List<(int col, int row)> ComputeReachable(int startCol, int startRow, int range)
    {
        if (_map is null) return new();
        var walls   = _map.Tiles.Where(t => t.Type == 2 || t.Type == 4).Select(t => (t.Col, t.Row)).ToHashSet();
        var result  = new List<(int, int)>();
        var visited = new HashSet<(int, int)> { (startCol, startRow) };
        var queue   = new Queue<(int col, int row, int dist)>();
        queue.Enqueue((startCol, startRow, 0));

        while (queue.Count > 0)
        {
            var (col, row, dist) = queue.Dequeue();
            if (dist > 0) result.Add((col, row));
            if (dist >= range) continue;
            foreach (var (dc, dr) in new[] { (0, 1), (0, -1), (1, 0), (-1, 0) })
            {
                int nc = col + dc, nr = row + dr;
                if (nc < 0 || nr < 0 || nc >= _map.Width || nr >= _map.Height) continue;
                if (walls.Contains((nc, nr))) continue;
                if (visited.Add((nc, nr))) queue.Enqueue((nc, nr, dist + 1));
            }
        }
        return result;
    }

